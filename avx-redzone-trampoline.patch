+#include "avx_trampoline.h"
+#include <limits.h>
+#include <string.h>
+
+#define FRAME_BYTES 0x600u
+
+typedef struct { uint8_t *p; } Emitter;
+static void u8(Emitter *e, uint8_t v) { *e->p++ = v; }
+static void u32(Emitter *e, uint32_t v) { for (unsigned i=0;i<4;i++) u8(e,(uint8_t)(v>>(8*i))); }
+static void u64(Emitter *e, uint64_t v) { for (unsigned i=0;i<8;i++) u8(e,(uint8_t)(v>>(8*i))); }
+static void bytes(Emitter *e,const void *p,size_t n) { memcpy(e->p,p,n); e->p+=n; }
+static void rsp_mem(Emitter *e,uint8_t rex,uint8_t opcode,int reg,uint32_t disp) {
+    u8(e,(uint8_t)(rex | (reg>=8 ? 4 : 0))); u8(e,opcode);
+    u8(e,(uint8_t)(0x84 | ((reg&7)<<3))); u8(e,0x24); u32(e,disp);
+}
+static void gpr_store(Emitter *e,int r,uint32_t d) { rsp_mem(e,0x48,0x89,r,d); }
+static void gpr_load(Emitter *e,int r,uint32_t d) { rsp_mem(e,0x48,0x8b,r,d); }
+static void xmm_mem(Emitter *e,int load,int r,uint32_t d) {
+    u8(e,0xf3); if(r>=8)u8(e,0x44); u8(e,0x0f); u8(e,load?0x6f:0x7f);
+    u8(e,(uint8_t)(0x84|((r&7)<<3)));u8(e,0x24);u32(e,d);
+}
+static int rel32(const uint8_t *next,const uint8_t *target,int32_t *out) {
+    int64_t d=(int64_t)((intptr_t)target-(intptr_t)next);
+    if(d<INT32_MIN||d>INT32_MAX) return 0;
+    *out=(int32_t)d;
+    return 1;
+}
+
+size_t avx_trampoline_emit(uint8_t *code,const uint8_t *at,
+                           const uint8_t *insn,size_t insn_len,
+                           const uint8_t *relocated,size_t relocated_len,
