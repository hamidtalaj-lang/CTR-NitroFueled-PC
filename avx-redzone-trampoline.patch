new file mode 100644
index 0000000..bc2e63d
--- /dev/null
+++ b/tests/test_avx_emulate_at.c
@@ -0,0 +1,27 @@
+#include "avx_emulate.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(void) {
+    /* vzeroupper; vmovups xmm0,[rip+0x10].  The emulator reads from a copied
+     * byte stream, but the second instruction's effective address is relative
+     * to its original guest IP (base + 3), not the copy's address. */
+    uint8_t original[64] = {0xc5,0xf8,0x77, 0xc5,0xf8,0x10,0x05,0x10,0,0,0};
+    uint8_t copied[16] = {0};
+    for (unsigned i = 0; i < 16; ++i) original[27 + i] = (uint8_t)(0x30 + i);
+    memcpy(copied, original, 11);
+    AvxState state;
+    memset(&state, 0, sizeof state);
+    int count = 0;
+    char why[160] = {0};
+    int consumed = avx_emulate_run_at(&state, copied, (uintptr_t)original, 4,
+                                      &count, why, sizeof why);
+    if (consumed != 11 || count != 2 || memcmp(state.xmm[0], original + 27, 16)) {
+        fprintf(stderr, "RIP-relative copied-instruction emulation failed: %s (len=%d count=%d)\n",
+                why, consumed, count);
+        return 1;
+    }
+    puts("AVX emulator: original RIP-relative address preserved across a copied run");
+    return 0;
+}
