index 0000000..f87962d
--- /dev/null
+++ b/src/avx_trampoline.h
@@ -0,0 +1,34 @@
+#ifndef BB_AVX_TRAMPOLINE_H
+#define BB_AVX_TRAMPOLINE_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* Private frame used by generated AVX trampolines.  The frame lives 0x600 bytes
+ * below the guest RSP, so neither the guest's 128-byte SysV red zone nor its
+ * stack contents are used for the host call. */
+typedef struct {
+    uint64_t gpr[16];
+    uint8_t _pad0[0x100 - sizeof(uint64_t) * 16];
+    uint8_t xmm[16][16];
+    uint64_t rflags;
+    uint32_t mxcsr;
+    uint32_t _pad1;
+    uint64_t _reserved;
+} AvxTrampolineFrame;
+
+_Static_assert(offsetof(AvxTrampolineFrame, xmm) == 0x100, "AVX frame XMM offset");
+_Static_assert(offsetof(AvxTrampolineFrame, rflags) == 0x200, "AVX frame flags offset");
+_Static_assert(offsetof(AvxTrampolineFrame, mxcsr) == 0x208, "AVX frame MXCSR offset");
+
+/* Emit a callable x86-64 stub.  `insn` is copied into the stub, `relocated`
+ * contains safe non-branching instructions displaced to make the 5-byte site
+ * patch possible.  `return_rip` is the first original byte after both ranges.
+ * Returns emitted size, or zero if the relative jump cannot reach. */
+size_t avx_trampoline_emit(uint8_t *code, const uint8_t *at,
+                           const uint8_t *insn, size_t insn_len,
+                           const uint8_t *relocated, size_t relocated_len,
+                           uintptr_t original_rip, uintptr_t return_rip,
+                           void (*bridge)(AvxTrampolineFrame *, const uint8_t *, uintptr_t, uint32_t));
+void avx_trampoline_bridge(AvxTrampolineFrame *, const uint8_t *, uintptr_t, uint32_t);
+
+#endif
