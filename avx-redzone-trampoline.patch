+
+uintptr_t avx_test_expected_rsp;
+uintptr_t avx_test_stub_target;
+static int bridge_ok;
+static const uintptr_t expected_rip = 0x12345678;
+
+#if defined(BB_TEST_WIN64_ABI)
+#define TEST_BRIDGE_ABI __attribute__((ms_abi))
+#else
+#define TEST_BRIDGE_ABI
+#endif
+static void TEST_BRIDGE_ABI test_bridge(AvxTrampolineFrame *frame, const uint8_t *insn,
+                                        uintptr_t original_rip, uint32_t expected_bytes) {
+    const uint8_t *redzone = (const uint8_t *)(uintptr_t)avx_test_expected_rsp - 128;
+    bridge_ok = frame->gpr[4] == avx_test_expected_rsp && original_rip == expected_rip &&
+                expected_bytes == 4 && !memcmp(insn, (const uint8_t[]){0xc5,0xf8,0x58,0xc1}, 4);
+    for (unsigned i = 0; i < 128; ++i) if (redzone[i] != 0xa5) bridge_ok = 0;
+    frame->gpr[0] = 0x1234abcd9876ull;
+}
+
+__attribute__((naked)) static uint64_t invoke_stub(void) {
+    __asm__ volatile(
+        "mov %rsp, avx_test_expected_rsp(%rip)\n"
+        "mov %rsp, %rdi\n"
+        "sub $128, %rdi\n"
+        "mov $128, %ecx\n"
+        "mov $0xa5, %eax\n"
+        "rep stosb\n"
+        "jmp *avx_test_stub_target(%rip)\n");
+}
+
+int main(void) {
+    const size_t page = (size_t)sysconf(_SC_PAGESIZE);
+    uint8_t *mem = mmap(NULL, page, PROT_READ | PROT_WRITE | PROT_EXEC,
+                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (mem == MAP_FAILED) return 2;
+    const uint8_t insn[] = {0xc5,0xf8,0x58,0xc1};
+    const uint8_t nop = 0x90;
+    uint8_t *return_site = mem + 900;
+    *return_site = 0xc3;
+#if defined(BB_TEST_WIN64_ABI)
+    const size_t size = avx_trampoline_emit(mem, mem, insn, sizeof insn, &nop, 1,
+        expected_rip, (uintptr_t)return_site,
+        (void (*)(AvxTrampolineFrame *, const uint8_t *, uintptr_t, uint32_t))test_bridge);
+#else
+    const size_t size = avx_trampoline_emit(mem, mem, insn, sizeof insn, &nop, 1,
+        expected_rip, (uintptr_t)return_site, test_bridge);
+#endif
+    if (!size) return 3;
+    avx_test_stub_target = (uintptr_t)mem;
+    const uint64_t result = invoke_stub();
+    uint8_t max_insn[15] = {0xc5,0xf8,0x58,0xc1};
+    uint8_t max_relocated[15];
+    memset(max_relocated, 0x90, sizeof max_relocated);
+#if defined(BB_TEST_WIN64_ABI)
+    const size_t max_size = avx_trampoline_emit(mem + 1024, mem + 1024, max_insn, sizeof max_insn,
+        max_relocated, sizeof max_relocated, expected_rip, (uintptr_t)return_site,
+        (void (*)(AvxTrampolineFrame *, const uint8_t *, uintptr_t, uint32_t))test_bridge);
+#else
+    const size_t max_size = avx_trampoline_emit(mem + 1024, mem + 1024, max_insn, sizeof max_insn,
+        max_relocated, sizeof max_relocated, expected_rip, (uintptr_t)return_site, test_bridge);
+#endif
+    munmap(mem, page);
+    if (!bridge_ok || result != 0x1234abcd9876ull || !max_size || max_size >= 768) {
+        fprintf(stderr, "AVX trampoline test failed (bridge=%d, result=%llx)\n",
+                bridge_ok, (unsigned long long)result);
+        return 1;
+    }
+    puts("AVX trampoline: stack/red-zone preservation passed");
+    return 0;
+}
+#else
+int main(void) { return 0; }
+#endif
