+    bytes(&e,(const uint8_t[]){0x49,0xb8},2);u64(&e,(uint64_t)original_rip); /* r8 = original RIP */
+    bytes(&e,(const uint8_t[]){0x41,0xb9},2);u32(&e,(uint32_t)insn_len); /* r9d = expected bytes */
+#else
+    bytes(&e,(const uint8_t[]){0x48,0x89,0xef},3); /* rdi = frame */
+    bytes(&e,(const uint8_t[]){0x48,0xbe},2);size_t insn_imm=(size_t)(e.p-code);u64(&e,0);
