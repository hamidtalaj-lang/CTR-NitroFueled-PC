+/* Linux host-side validation for the generated SysV trampoline.  It jumps into
+ * the stub (rather than calling it), paints the guest red zone, and verifies
+ * that the bridge sees the original stack and intact bytes. */
+#if !defined(_WIN32) || defined(BB_TEST_WIN64_ABI)
+#define _GNU_SOURCE
+#include "avx_trampoline.h"
+#include <stdint.h>
