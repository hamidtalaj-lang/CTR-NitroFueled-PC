+++ b/tests/test_isa_rewrite_stub.c
@@ -0,0 +1,21 @@
+/* Checks that the larger GPR+XMM save/restore stub fits its allocation and rewrites a site. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../src/isa_rewrite.h"
+
+int main(void) {
+    unsigned char arena[4096]; memset(arena, 0, sizeof arena);
+    unsigned char *image = arena, *stubs = arena + 512;
+    IsaSite s; memset(&s, 0, sizeof s);
+    s.length = 5; s.kind = ISA_AVX; s.width = 128; s.mode = ISA_MODE_JMP;
+    s.dst = 0; s.src1 = 1; s.src2 = 2; s.base = ISA_NO_REG; s.index = ISA_NO_REG;
+    memset(s.original, 0x90, s.length); memcpy(image, s.original, s.length);
+    uint64_t hit = 0;
+    IsaTable t; memset(&t, 0, sizeof t);
+    t.sites = &s; t.hits = &hit; t.count = 1; t.image_size = 128;
+    IsaReport r = isa_rewrite_apply(&t, image, stubs, CPU_SET_AVX);
+    assert(r.rewritten == 1 && r.skipped == 0 && r.jmp == 1 && image[0] == 0xe9);
+    puts("ISA rewrite stub tests: PASS");
+    return 0;
+}
