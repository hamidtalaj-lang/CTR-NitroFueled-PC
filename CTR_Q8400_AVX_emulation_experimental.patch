diff --git a/tests/test_isa_emulate.c b/tests/test_isa_emulate.c
new file mode 100644
index 0000000..0f45dc8
--- /dev/null
+++ b/tests/test_isa_emulate.c
@@ -0,0 +1,112 @@
+/* Standalone smoke tests for the older-CPU ISA emulator. Build with:
+ *   cc -std=c11 -O2 -Wall -Wextra -Werror -mno-avx -mno-avx2 src/isa_emulate.c tests/test_isa_emulate.c -o /tmp/test-isa && /tmp/test-isa
+ */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "../src/isa_emulate.h"
+
+static IsaSite make_site(uint8_t kind, uint8_t width, uint8_t dst, uint8_t src1, uint8_t src2,
+                         uint8_t mem_slot, uint8_t base, const unsigned char *bytes, uint8_t length) {
+    IsaSite s;
+    memset(&s, 0, sizeof s);
+    s.kind = kind; s.width = width; s.dst = dst; s.src1 = src1; s.src2 = src2;
+    s.mem_slot = mem_slot; s.base = base; s.index = ISA_NO_REG; s.scale = 1;
+    s.length = length; memcpy(s.original, bytes, length);
+    return s;
+}
+
+int main(void) {
+    IsaRegs r; memset(&r, 0, sizeof r);
+    const unsigned char vzero_upper[] = {0xc5, 0xf8, 0x77};
+    r.xmm[0][0] = 0x5a;
+    IsaSite s = make_site(ISA_AVX, 0, ISA_NO_REG, ISA_NO_REG, ISA_NO_REG, 0, ISA_NO_REG, vzero_upper, 3);
+    isa_emulate(&s, &r);
+    assert(r.xmm[0][0] == 0x5a); /* VZEROUPPER preserves the low XMM half. */
+    const unsigned char vzero_all[] = {0xc5, 0xfc, 0x77};
+    s = make_site(ISA_AVX, 0, ISA_NO_REG, ISA_NO_REG, ISA_NO_REG, 0, ISA_NO_REG, vzero_all, 3);
+    isa_emulate(&s, &r);
+    for (int i = 0; i < 16; ++i) assert(r.xmm[0][i] == 0);
+
+    const unsigned char vxor[] = {0xc5, 0xf0, 0x57, 0xc2}; /* vxorps xmm0,xmm1,xmm2 */
+    for (int i = 0; i < 16; ++i) { r.xmm[1][i] = (uint8_t)(i * 3); r.xmm[2][i] = (uint8_t)(0xf0 + i); }
+    s = make_site(ISA_AVX, 128, 0, 1, 2, 0, ISA_NO_REG, vxor, 4);
+    isa_emulate(&s, &r);
+    for (int i = 0; i < 16; ++i) assert(r.xmm[0][i] == ((uint8_t)(i * 3) ^ (uint8_t)(0xf0 + i)));
+
+    /* VSHUFPS xmm0,xmm1,xmm2,1Bh selects lanes 3,2 from src1 and 1,0 from src2. */
+    float shuf_a[4] = {1,2,3,4}, shuf_b[4] = {10,20,30,40}, shuf_out[4] = {0};
+    memcpy(r.xmm[1], shuf_a, 16); memcpy(r.xmm[2], shuf_b, 16);
+    const unsigned char vshufps[] = {0xc5, 0xf0, 0xc6, 0xc2, 0x1b};
+    s = make_site(ISA_AVX, 128, 0, 1, 2, 0, ISA_NO_REG, vshufps, 5); isa_emulate(&s, &r);
+    memcpy(shuf_out, r.xmm[0], 16);
+    assert(shuf_out[0] == 4 && shuf_out[1] == 3 && shuf_out[2] == 20 && shuf_out[3] == 10);
+
+    /* VMOVMSKPS extracts the sign bits of four float lanes into a zero-extended GPR. */
+    uint32_t signs[4] = {0x80000000u, 0, 0x80000000u, 0};
+    memcpy(r.xmm[1], signs, 16);
+    const unsigned char vmovmskps[] = {0xc5, 0xf8, 0x50, 0xc1};
+    s = make_site(ISA_AVX, 128, 0, 1, ISA_NO_REG, 0, ISA_NO_REG, vmovmskps, 4); isa_emulate(&s, &r);
+    assert(r.gpr[0] == 5);
+
+    /* VADDSS changes only lane 0 and copies the upper XMM lanes from src1. */
+    float scalar_a[4] = {1.25f, 2.0f, 3.0f, 4.0f}, scalar_b[4] = {2.5f, 20.0f, 30.0f, 40.0f}, scalar_out[4];
+    memcpy(r.xmm[1], scalar_a, 16); memcpy(r.xmm[2], scalar_b, 16);
+    const unsigned char vaddss[] = {0xc5, 0xf2, 0x58, 0xc2};
+    s = make_site(ISA_AVX, 128, 0, 1, 2, 0, ISA_NO_REG, vaddss, 4); isa_emulate(&s, &r);
+    memcpy(scalar_out, r.xmm[0], 16);
+    assert(scalar_out[0] == 3.75f && scalar_out[1] == 2.0f && scalar_out[2] == 3.0f && scalar_out[3] == 4.0f);
+
+    /* Load two YMM vectors from memory, add them, and store: checks the software upper halves. */
+    unsigned char mem[96]; memset(mem, 0, sizeof mem);
+    float a[8] = {1,2,3,4,5,6,7,8}, b[8] = {10,20,30,40,50,60,70,80}, out[8] = {0};
+    memcpy(mem, a, sizeof a); memcpy(mem + 32, b, sizeof b);
+    r.gpr[0] = (uintptr_t)mem;
+    const unsigned char vmov_load1[] = {0xc5, 0xfc, 0x10, 0x08}; /* vmovups ymm1,[rax] */
+    s = make_site(ISA_AVX, 255, 1, ISA_NO_REG, ISA_NO_REG, 2, 0, vmov_load1, 4); isa_emulate(&s, &r);
+    const unsigned char vmov_load2[] = {0xc5, 0xfc, 0x10, 0x50, 0x20}; /* vmovups ymm2,[rax+20h] */
+    s = make_site(ISA_AVX, 255, 2, ISA_NO_REG, ISA_NO_REG, 2, 0, vmov_load2, 5); s.disp = 32; isa_emulate(&s, &r);
+    const unsigned char vadd[] = {0xc5, 0xf4, 0x58, 0xc2}; /* vaddps ymm0,ymm1,ymm2 */
+    s = make_site(ISA_AVX, 255, 0, 1, 2, 0, ISA_NO_REG, vadd, 4); isa_emulate(&s, &r);
+    const unsigned char vmov_store[] = {0xc5, 0xfc, 0x11, 0x00}; /* vmovups [rax],ymm0 */
+    s = make_site(ISA_AVX, 255, ISA_NO_REG, 0, ISA_NO_REG, 1, 0, vmov_store, 4); isa_emulate(&s, &r);
+    memcpy(out, mem, sizeof out);
+    for (int i = 0; i < 8; ++i) assert(out[i] == a[i] + b[i]);
+
+    /* VPERM2F128 ymm0,ymm1,ymm2,1 selects src1's high half for low and src1 low for high. */
+    const unsigned char vperm2f128[] = {0xc4, 0xe3, 0x75, 0x06, 0xc2, 0x01};
+    s = make_site(ISA_AVX, 255, 0, 1, 2, 0, ISA_NO_REG, vperm2f128, 6); isa_emulate(&s, &r);
+    const unsigned char vmov_store2[] = {0xc5, 0xfc, 0x11, 0x00};
+    s = make_site(ISA_AVX, 255, ISA_NO_REG, 0, ISA_NO_REG, 1, 0, vmov_store2, 4); isa_emulate(&s, &r);
+    float perm_out[8]; memcpy(perm_out, mem, sizeof perm_out);
+    assert(perm_out[0] == 5 && perm_out[1] == 6 && perm_out[2] == 7 && perm_out[3] == 8);
+    assert(perm_out[4] == 1 && perm_out[5] == 2 && perm_out[6] == 3 && perm_out[7] == 4);
+
+    /* CRC32C byte operation, CRC=0 and source byte '1'. */
+    const unsigned char crc32[] = {0xf2, 0x0f, 0x38, 0xf0, 0xc1};
+    r.gpr[0] = 0; r.gpr[1] = '1';
+    s = make_site(ISA_CRC32, 32, 0, 1, ISA_NO_REG, 0, ISA_NO_REG, crc32, 5);
+    isa_emulate(&s, &r);
+    assert((uint32_t)r.gpr[0] == 0xc288cab2u);
+
+    /* PCMPGTQ compares signed 64-bit lanes and writes all-ones/zero masks. */
+    int64_t q1[2] = {5, -2}, q2[2] = {4, -1};
+    const unsigned char pcmpgtq[] = {0x66, 0x0f, 0x38, 0x37, 0xc1};
+    memcpy(r.xmm[0], q1, 16); memcpy(r.xmm[1], q2, 16);
+    s = make_site(ISA_PCMPGTQ, 128, 0, 1, ISA_NO_REG, 0, ISA_NO_REG, pcmpgtq, 5);
+    isa_emulate(&s, &r);
+    uint64_t qresult[2]; memcpy(qresult, r.xmm[0], 16);
+    assert(qresult[0] == ~0ull && qresult[1] == 0);
+
+    /* POPCNT updates ZF from the source and clears all other architecturally defined flags. */
+    const unsigned char popcnt[] = {0xf3, 0x0f, 0xb8, 0xc1};
+    s = make_site(ISA_POPCNT, 32, 0, 1, ISA_NO_REG, 0, ISA_NO_REG, popcnt, 4);
+    r.gpr[1] = 0xf0; r.rflags = ~0ull; isa_emulate(&s, &r);
+    assert(r.gpr[0] == 4 && !(r.rflags & ISA_ZF));
+    r.gpr[1] = 0; isa_emulate(&s, &r);
+    assert(r.gpr[0] == 0 && (r.rflags & ISA_ZF));
+
+    puts("ISA emulator tests: PASS");
+    return 0;
+}
