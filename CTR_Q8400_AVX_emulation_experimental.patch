@@ -64,16 +69,319 @@ static uint64_t zf_sf(const IsaSite *site, uint64_t result) {
     return (result == 0 ? ISA_ZF : 0) | (result >> (site->width - 1) & 1 ? ISA_SF : 0);
 }
 
+static uint64_t load_bits(const IsaSite *site, const IsaRegs *regs, unsigned bits) {
+    unsigned char *at = effective_address(site, regs);
+    uint64_t value = 0;
+    __builtin_memcpy(&value, at, bits / 8);
+    return value;
+}
+
+static unsigned crc_source_bits(const IsaSite *site) {
+    int operand16 = 0, rex_w = 0;
+    unsigned opcode = 0;
+    for (unsigned i = 0; i < site->length; ++i) {
+        unsigned b = site->original[i];
+        if (b == 0x66) operand16 = 1;
+        if (b >= 0x40 && b <= 0x4f) rex_w = !!(b & 8);
+        if (b == 0xf0 || b == 0xf1) { opcode = b; break; }
+    }
+    if (opcode == 0xf0) return 8;
+    if (operand16) return 16;
+    return rex_w ? 64 : 32;
+}
+
+static void emulate_crc32(const IsaSite *site, IsaRegs *regs) {
+    unsigned bits = crc_source_bits(site);
+    uint64_t source;
+    if (site->src1 == ISA_NO_REG && site->mem_slot == ISA_MEM_SRC)
+        source = load_bits(site, regs, bits);
+    else
+        source = regs->gpr[site->src1] & (bits == 64 ? ~0ull : (1ull << bits) - 1);
+    uint32_t crc = (uint32_t)regs->gpr[site->dst];
+    for (unsigned i = 0; i < bits / 8; ++i) {
+        crc ^= (uint8_t)(source >> (i * 8));
+        for (unsigned bit = 0; bit < 8; ++bit)
+            crc = (crc >> 1) ^ (0x82f63b78u & (uint32_t)-(int32_t)(crc & 1));
+    }
+    /* CRC32 writes a 32-bit result and zero-extends it, even for a 64-bit destination. */
+    regs->gpr[site->dst] = crc;
+}
+
+static unsigned vex_info(const IsaSite *site, unsigned *map, unsigned *pp, unsigned *l,
+                         unsigned *opcode_at) {
+    if (site->length < 3) return 0;
+    if (site->original[0] == 0xc5) {
+        *map = 1;
+        *pp = site->original[1] & 3;
+        *l = (site->original[1] >> 2) & 1;
+        *opcode_at = 2;
+        return 1;
+    }
+    if (site->original[0] == 0xc4 && site->length >= 4) {
+        *map = site->original[1] & 0x1f;
+        *pp = site->original[2] & 3;
+        *l = (site->original[2] >> 2) & 1;
+        *opcode_at = 3;
+        return 1;
+    }
+    return 0;
+}
+
