+    h->rip = (uintptr_t)ip; h->count = 1;
+    memcpy(h->bytes, bytes, 8);
+    unsigned long long n = __atomic_add_fetch(&avx_stub_emulated, 1, __ATOMIC_RELAXED);
+    if ((n & ((1ull << 22) - 1)) == 0) { fprintf(stderr, "AVX stubs: %llu instructions so far\n", n); fflush(stderr); }
+}
