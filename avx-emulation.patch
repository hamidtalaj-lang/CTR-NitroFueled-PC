+/* ------------------------------------------------------------------------------------------ */
+/* Native thunks: one legacy SSE instruction + ret, cached by its bytes.                        */
+/* ------------------------------------------------------------------------------------------ */
+typedef struct {
+    uint8_t x[4][16];            /* 0: xmm0..xmm3 */
+    uint64_t rax, rcx, rdx, rbx; /* 64..88 */
+    uint64_t flags;              /* 96 */
+    uint32_t mxcsr, pad;         /* 104 */
+} Thunk;
+
+static void call_thunk(const void *code, Thunk *t) {
+    uint32_t host;
+    __asm__ volatile(
+        "stmxcsr %[host]\n\t"
+        "ldmxcsr 104(%%rsi)\n\t"
+        "movups   0(%%rsi), %%xmm0\n\t"
+        "movups  16(%%rsi), %%xmm1\n\t"
+        "movups  32(%%rsi), %%xmm2\n\t"
+        "movups  48(%%rsi), %%xmm3\n\t"
+        "movq    72(%%rsi), %%rcx\n\t"
+        "movq    80(%%rsi), %%rdx\n\t"
+        "movq    88(%%rsi), %%rbx\n\t"
+        "movq    64(%%rsi), %%rax\n\t"
+        "call *%%rdi\n\t"
+        "movups %%xmm0,  0(%%rsi)\n\t"
+        "movups %%xmm1, 16(%%rsi)\n\t"
+        "movups %%xmm2, 32(%%rsi)\n\t"
+        "movups %%xmm3, 48(%%rsi)\n\t"
+        "movq   %%rax, 64(%%rsi)\n\t"
+        "movq   %%rcx, 72(%%rsi)\n\t"
+        "movq   %%rdx, 80(%%rsi)\n\t"
+        "movq   %%rbx, 88(%%rsi)\n\t"
+        "pushfq\n\t"
+        "popq   96(%%rsi)\n\t"
+        "stmxcsr 104(%%rsi)\n\t"
+        "ldmxcsr %[host]\n\t"
+        : [host] "=m"(host)
+        : "S"(t), "D"(code)
+        : "rax", "rcx", "rdx", "rbx", "memory", "cc", "xmm0", "xmm1", "xmm2", "xmm3");
+}
+
+enum { CACHE_SLOTS = 8192, POOL_BYTES = 1 << 18 };
+typedef struct { uint8_t key[16]; uint8_t n; volatile int ready; const void *code; } CacheEntry;
+static CacheEntry cache[CACHE_SLOTS];
+static uint8_t *pool;
+static size_t pool_used;
+static volatile int cache_lock;
+
+static uint8_t *alloc_exec(size_t n) {
+#ifdef _WIN32
+    return VirtualAlloc(NULL, n, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+#else
+    void *p = mmap(NULL, n, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    return p == MAP_FAILED ? NULL : p;
+#endif
+}
+
+static const void *get_thunk(const uint8_t *bytes, int n) {
+    uint8_t key[16] = {0};
+    memcpy(key, bytes, (size_t)n);
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < 16; ++i) h = (h ^ key[i]) * 16777619u;
+    for (int pass = 0; pass < 2; ++pass) {
+        if (pass) while (__atomic_exchange_n(&cache_lock, 1, __ATOMIC_ACQUIRE)) {}
+        for (uint32_t i = 0; i < CACHE_SLOTS; ++i) {
+            CacheEntry *e = &cache[(h + i) % CACHE_SLOTS];
+            if (__atomic_load_n(&e->ready, __ATOMIC_ACQUIRE)) {
+                if (e->n == n && !memcmp(e->key, key, 16)) { if (pass) __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE); return e->code; }
+                continue;
+            }
+            if (!pass) break;                    /* miss: retry under the lock */
+            if (!pool) pool = alloc_exec(POOL_BYTES);
+            if (!pool || pool_used + 16 > POOL_BYTES) { __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE); return NULL; }
+            uint8_t *slot = pool + pool_used;
+            pool_used += 16;
+            memcpy(slot, bytes, (size_t)n);
+            memcpy(e->key, key, 16);
+            e->n = (uint8_t)n;
+            e->code = slot;
+            __atomic_store_n(&e->ready, 1, __ATOMIC_RELEASE);
+            __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE);
+            return slot;
+        }
+    }
+    __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE);
+    return NULL;
+}
