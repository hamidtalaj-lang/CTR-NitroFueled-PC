+    char *colon = strchr(key, ':'); if (colon) { colon = strchr(colon + 1, ':'); if (colon) *colon = 0; }
+    /* group by message and the first bytes that identify the opcode */
+    char k2[160]; snprintf(k2, sizeof k2, "%s", why);
+    for (int i = 0; i < nreasons; ++i) if (!strncmp(reasons[i].text, k2, 40) && !strncmp(reasons[i].text, k2, strlen(k2) > 46 ? 46 : strlen(k2))) { reasons[i].n++; return; }
+    if (nreasons < 4000) { snprintf(reasons[nreasons].text, 160, "%s", k2); reasons[nreasons].n = 1; ++nreasons; }
+}
