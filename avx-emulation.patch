diff --git a/scripts/avx_rewrite.py b/scripts/avx_rewrite.py
new file mode 100644
index 0000000..bf3b48d
--- /dev/null
+++ b/scripts/avx_rewrite.py
@@ -0,0 +1,187 @@
+#!/usr/bin/env python3
+"""Builds out/avx-rewrite.bin (BBAVX1), the table src/avx_stub.c applies at load time.
+
+The game's AVX / POPCNT / SSE4.2 instructions fault on a CPU without them. On Windows the fault is
+delivered with the exception record written *below rsp*, which destroys the System V red zone of the
+guest's leaf functions (see docs/avx-emulation.md). A site covered by this table is instead patched with
+a 5-byte jmp to a stub that skips 0x100 bytes below rsp first and emulates the instructions in
+ordinary code, so no exception is raised there. Sites this script cannot cover stay on the fault path.
+
+A site is a straight run of emulated instructions (up to 32 bytes). No instruction inside the run may be
+a code address that something else can jump to: direct branches from any executable segment, code
+pointers in data (the relocation table), rip-relative references into code, and the targets of
+relative jump tables (int32 entries after a `lea reg,[rip+table]`) all count. A jump into the middle of a
+covered run lands in the 5-byte jmp (the first 5 bytes are overwritten) and crashes. A run shorter than 5 bytes borrows the plain instruction after it, which then
+executes natively in the stub. BMI1/MOVBE/LZCNT/TZCNT are left to scripts/isa_rewrite.py.
+
+usage: avx_rewrite.py boot-linked.bin [--out DIR]       (needs `pip install iced-x86`)"""
+import argparse
+from dataclasses import dataclass
+import hashlib
+from pathlib import Path
+import struct
+import sys
+sys.path.insert(0, __file__.rsplit('/', 1)[0] if '/' in __file__ else '.')
+
+from prepare import span
+try:
+    import iced_x86
+    from iced_x86 import Decoder, EncodingKind, FlowControl, Mnemonic, OpKind
+except ImportError:
+    iced_x86 = None
+
+EMU_MAX, RELOC_MAX, MIN_COVER = 32, 16, 5
+HEADER = struct.Struct('<8sQ32sI12x')     # magic, image size, sha256, sites     (64 bytes)
+RECORD = struct.Struct('<QBBB5x32s16s')   # offset, emu_len, n_insn, reloc_len, emu, reloc (64 bytes, AvxSite)
+
+
+@dataclass
+class Insn:
+    ip: int
+    data: bytes
+    emulated: bool       # VEX / POPCNT / CRC32 / PCMPGTQ / PCMPxSTRx that the host may lack
+    plain: bool          # may be copied into a stub and run natively
+    target: bool         # a direct branch jumps here
+
+
+@dataclass
+class Site:
+    offset: int
+    emu: bytes
+    n_insn: int
+    reloc: bytes
+
+
+def plan(insns):
+    """Sites for a list of Insn in address order (pure function: the tests feed it hand-made lists)."""
+    sites, i = [], 0
+    while i < len(insns):
+        if not insns[i].emulated:
+            i += 1
+            continue
+        j, size = i, 0
+        while j < len(insns) and insns[j].emulated and (j == i or (not insns[j].target and insns[j].ip == insns[j - 1].ip + len(insns[j - 1].data))) \
+                and size + len(insns[j].data) <= EMU_MAX:
+            size += len(insns[j].data)
+            j += 1
+        reloc = b''
+        if size < MIN_COVER and j < len(insns):
+            nxt = insns[j]
+            if nxt.plain and not nxt.target and nxt.ip == insns[j - 1].ip + len(insns[j - 1].data) and len(nxt.data) <= RELOC_MAX:
+                reloc = nxt.data
+        if size + len(reloc) >= MIN_COVER:
+            sites.append(Site(insns[i].ip, b''.join(x.data for x in insns[i:j]), j - i, reloc))
+        i = max(j, i + 1)
+    return sites
+
+
+def encode_table(image, sites):
+    table = [HEADER.pack(b'BBAVX1\0\0', len(image), hashlib.sha256(image).digest(), len(sites))]
+    for s in sorted(sites, key=lambda s: s.offset):
+        table.append(RECORD.pack(s.offset, len(s.emu), s.n_insn, len(s.reloc), s.emu, s.reloc))
+    return b''.join(table)
+
+
+def _emulated(ins):
+    from isa_rewrite import kind_of, KIND_VCVTPH2PS, KIND_VCVTPS2PH
+    if kind_of(ins) not in (None, KIND_VCVTPH2PS, KIND_VCVTPS2PH):
+        return False                                   # isa_rewrite.py owns these
+    return ins.encoding == EncodingKind.VEX or ins.mnemonic in (
+        Mnemonic.POPCNT, Mnemonic.CRC32, Mnemonic.PCMPGTQ, Mnemonic.PCMPESTRI, Mnemonic.PCMPESTRM,
+        Mnemonic.PCMPISTRI, Mnemonic.PCMPISTRM)
+
+
+def read_relocs(data):
+    """Image offsets that internal pointers (relocation kind 0) point to, from a BBPROBE5 file (same layout walk as
+    isa_rewrite.read_boot_linked)."""
+    from prepare import unpack
+    magic, size, entry, ns, nr, ni, flags = unpack('<8s6Q', data, 0)
+    pos = 56 + 8 + 32
+    nmodules, = unpack('<Q', data, pos)
+    pos += 8 + nmodules * 56
+    nbindings, = unpack('<Q', data, pos)
+    pos += 8 + nbindings * 24 + ns * 24 + ni * 128
+    out = []
+    for i in range(nr):
+        target, kind, value, addend = unpack('<4Q', data, pos + i * 32)
+        if kind == 0:
+            out.append(value)
+    return out
+
+
+def table_targets(image, base, in_code, limit=4096):
+    """Code addresses in the relative jump table at image offset base (int32 entries relative to the table)."""
+    out = []
+    for k in range(limit):
+        o = base + 4 * k
+        if o < 0 or o + 4 > len(image):
+            break
+        t = base + struct.unpack_from('<i', image, o)[0]
+        if not in_code(t):
+            break
+        out.append(t)
+    return out
+
+
+def scan(segments, image, reloc_values):
+    """Sites of every executable segment. Branch targets are collected over all of them first: a branch in one
+    segment may land in another."""
+    ranges = [(a, a + n) for a, n, f in segments if f & 1]
+    in_code = lambda x: any(a <= x < e for a, e in ranges)
+    targets = {v for v in reloc_values if in_code(v)}
+    per_segment = []
+    from isa_rewrite import is_plain
+    for address, size, flags in segments:
+        if not flags & 1:
+            continue
+        code = span(image, address, size)
+        end = address + size
+        kept, last_emulated = [], False
+        for ins in Decoder(64, code, ip=address):
+            if ins.flow_control in (FlowControl.UNCONDITIONAL_BRANCH, FlowControl.CONDITIONAL_BRANCH, FlowControl.CALL) \
+                    and ins.op0_kind == OpKind.NEAR_BRANCH64:
+                targets.add(ins.near_branch_target)
+            if ins.is_ip_rel_memory_operand:
+                t = ins.ip_rel_memory_address
+                if in_code(t):
+                    targets.add(t)
+                elif ins.mnemonic == Mnemonic.LEA and 0 <= t < len(image):
+                    targets.update(table_targets(image, t, in_code))
+            emulated = _emulated(ins)
+            if emulated or last_emulated:       # only these are needed by plan(); the rest is dropped to save memory
+                kept.append(Insn(ins.ip, code[ins.ip - address:ins.next_ip - address], emulated,
+                                 not emulated and is_plain(ins, end), False))
+            last_emulated = emulated
+        per_segment.append(kept)
+    sites = []
+    for kept in per_segment:
+        for insn in kept:
+            insn.target = insn.ip in targets
+        sites.extend(plan(kept))
+    return sites, len(targets)
+
+
+def main(argv):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('boot', type=Path)
+    p.add_argument('--out', type=Path, default=Path(__file__).resolve().parent.parent / 'out')
+    a = p.parse_args(argv)
+    try:
+        if iced_x86 is None:
+            raise RuntimeError('iced_x86 is not installed')
+        from isa_rewrite import read_boot_linked
+        data = a.boot.read_bytes()
+        segments, image = read_boot_linked(data)
+        sites, n_targets = scan(segments, image, read_relocs(data))
+        (a.out / 'avx-rewrite.bin').write_bytes(encode_table(image, sites))
+    except (OSError, ValueError, RuntimeError) as e:
+        print(f'AVX: rewrite table unavailable ({e})')
+        return 1
+    n = sum(s.n_insn for s in sites)
+    print(f'AVX: {len(sites)} stub sites covering {n} instructions, {sum(1 for s in sites if s.reloc)} with a relocated '
+          f'instruction; {n_targets} code addresses are jump targets')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv[1:]))
diff --git a/scripts/avx_samples.py b/scripts/avx_samples.py
new file mode 100644
index 0000000..01148e5
--- /dev/null
+++ b/scripts/avx_samples.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Lists every distinct AVX (VEX) and POPCNT/CRC32/PCMPGTQ instruction encoding in eboot.bin, one hex
+string per line, for tests/test_avx_emulate.c (which runs them on a CPU that has AVX and compares
+the emulator with the real thing). Needs binutils' objdump.   usage: avx_samples.py eboot.bin out.txt"""
+import subprocess, sys
+sys.path.insert(0, __file__.rsplit('/', 1)[0] if '/' in __file__ else '.')
+from prepare import parse_self
+
+elf = parse_self(open(sys.argv[1], 'rb').read())[0]
+program_headers = elf[0x40:0x40 + 56 * int.from_bytes(elf[0x38:0x3A], 'little')]
+text = None
+for i in range(0, len(program_headers), 56):
+    ptype, flags = int.from_bytes(program_headers[i:i+4], 'little'), int.from_bytes(program_headers[i+4:i+8], 'little')
+    if ptype == 1 and flags & 1:
+        offset, size = int.from_bytes(program_headers[i+8:i+16], 'little'), int.from_bytes(program_headers[i+32:i+40], 'little')
+        text = elf[offset:offset + size]
+        break
+import os
+text = text[:int(os.environ.get('AVX_SAMPLES_LIMIT', len(text)))]
+open('/tmp/avx_text.bin', 'wb').write(text)
+dis = subprocess.Popen(['objdump', '-D', '-b', 'binary', '-m', 'i386:x86-64', '-M', 'intel', '/tmp/avx_text.bin'],
+                       stdout=subprocess.PIPE, text=True).stdout
+seen, cur = set(), None
+
+def flush():
+    if cur:
+        data, mnemonic = cur
+        if data and data[0] in ('c4', 'c5') or mnemonic in ('popcnt', 'crc32', 'pcmpgtq'):
+            seen.add(''.join(data))
+
+for line in dis:
+    parts = line.rstrip('\n').split('\t')
+    if len(parts) >= 2 and parts[0].strip().endswith(':'):
+        if len(parts) >= 3 and parts[2].strip():
+            flush()
+            cur = (parts[1].split(), parts[2].split()[0])
+        elif cur:
+            cur[0].extend(parts[1].split())
+flush()
+open(sys.argv[2], 'w').write('\n'.join(sorted(seen)) + '\n')
+print(len(seen), 'distinct encodings')
diff --git a/src/avx_emulate.c b/src/avx_emulate.c
new file mode 100644
index 0000000..064caea
--- /dev/null
+++ b/src/avx_emulate.c
@@ -0,0 +1,1014 @@
+/* See avx_emulate.h. Build with -mno-red-zone (the thunk call pushes below rsp). */
+#include "avx_emulate.h"
+#include <stdio.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#endif
+
+/* ------------------------------------------------------------------------------------------ */
+/* Native thunks: one legacy SSE instruction + ret, cached by its bytes.                        */
+/* ------------------------------------------------------------------------------------------ */
+typedef struct {
+    uint8_t x[4][16];            /* 0: xmm0..xmm3 */
+    uint64_t rax, rcx, rdx, rbx; /* 64..88 */
+    uint64_t flags;              /* 96 */
+    uint32_t mxcsr, pad;         /* 104 */
+} Thunk;
+
+static void call_thunk(const void *code, Thunk *t) {
+    uint32_t host;
+    __asm__ volatile(
+        "stmxcsr %[host]\n\t"
+        "ldmxcsr 104(%%rsi)\n\t"
+        "movups   0(%%rsi), %%xmm0\n\t"
+        "movups  16(%%rsi), %%xmm1\n\t"
+        "movups  32(%%rsi), %%xmm2\n\t"
+        "movups  48(%%rsi), %%xmm3\n\t"
+        "movq    72(%%rsi), %%rcx\n\t"
+        "movq    80(%%rsi), %%rdx\n\t"
+        "movq    88(%%rsi), %%rbx\n\t"
+        "movq    64(%%rsi), %%rax\n\t"
+        "call *%%rdi\n\t"
+        "movups %%xmm0,  0(%%rsi)\n\t"
+        "movups %%xmm1, 16(%%rsi)\n\t"
+        "movups %%xmm2, 32(%%rsi)\n\t"
+        "movups %%xmm3, 48(%%rsi)\n\t"
+        "movq   %%rax, 64(%%rsi)\n\t"
+        "movq   %%rcx, 72(%%rsi)\n\t"
+        "movq   %%rdx, 80(%%rsi)\n\t"
+        "movq   %%rbx, 88(%%rsi)\n\t"
+        "pushfq\n\t"
+        "popq   96(%%rsi)\n\t"
+        "stmxcsr 104(%%rsi)\n\t"
+        "ldmxcsr %[host]\n\t"
+        : [host] "=m"(host)
+        : "S"(t), "D"(code)
+        : "rax", "rcx", "rdx", "rbx", "memory", "cc", "xmm0", "xmm1", "xmm2", "xmm3");
+}
+
+enum { CACHE_SLOTS = 8192, POOL_BYTES = 1 << 18 };
+typedef struct { uint8_t key[16]; uint8_t n; volatile int ready; const void *code; } CacheEntry;
+static CacheEntry cache[CACHE_SLOTS];
+static uint8_t *pool;
+static size_t pool_used;
+static volatile int cache_lock;
+
+static uint8_t *alloc_exec(size_t n) {
+#ifdef _WIN32
+    return VirtualAlloc(NULL, n, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+#else
+    void *p = mmap(NULL, n, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    return p == MAP_FAILED ? NULL : p;
+#endif
+}
+
+static const void *get_thunk(const uint8_t *bytes, int n) {
+    uint8_t key[16] = {0};
+    memcpy(key, bytes, (size_t)n);
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < 16; ++i) h = (h ^ key[i]) * 16777619u;
+    for (int pass = 0; pass < 2; ++pass) {
+        if (pass) while (__atomic_exchange_n(&cache_lock, 1, __ATOMIC_ACQUIRE)) {}
+        for (uint32_t i = 0; i < CACHE_SLOTS; ++i) {
+            CacheEntry *e = &cache[(h + i) % CACHE_SLOTS];
+            if (__atomic_load_n(&e->ready, __ATOMIC_ACQUIRE)) {
+                if (e->n == n && !memcmp(e->key, key, 16)) { if (pass) __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE); return e->code; }
+                continue;
+            }
+            if (!pass) break;                    /* miss: retry under the lock */
+            if (!pool) pool = alloc_exec(POOL_BYTES);
+            if (!pool || pool_used + 16 > POOL_BYTES) { __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE); return NULL; }
+            uint8_t *slot = pool + pool_used;
+            pool_used += 16;
+            memcpy(slot, bytes, (size_t)n);
+            memcpy(e->key, key, 16);
+            e->n = (uint8_t)n;
+            e->code = slot;
+            __atomic_store_n(&e->ready, 1, __ATOMIC_RELEASE);
+            __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE);
+            return slot;
+        }
+    }
+    __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE);
+    return NULL;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* Decoder                                                                                      */
+/* ------------------------------------------------------------------------------------------ */
+typedef struct {
+    int map, pp, L, W, vvvv, opc;
+    int reg, rm;                 /* extended register numbers (rm: register form only) */
+    int ext;                     /* modrm.reg low 3 bits (opcode extension) */
+    int is_mem, has_base, has_index, ripr, base, index, scale;
+    int64_t disp;
+    int has_imm; uint8_t imm;
+    int len;
+} Dec;
+
+static int fail(char *why, size_t n, const uint8_t *p, const char *msg) {
+    if (why && n) snprintf(why, n, "%s: %02x %02x %02x %02x %02x %02x %02x %02x", msg, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    return 0;
+}
+
+/* Decodes modrm/sib/disp at p[*i]; rexr/rexx/rexb are the 0/1 extension bits. */
+static void decode_modrm(const uint8_t *p, int *i, Dec *d, int rexr, int rexx, int rexb) {
+    uint8_t m = p[(*i)++];
+    int mod = m >> 6, rm = m & 7;
+    d->ext = (m >> 3) & 7;
+    d->reg = d->ext | (rexr << 3);
+    if (mod == 3) { d->is_mem = 0; d->rm = rm | (rexb << 3); return; }
+    d->is_mem = 1;
+    if (rm == 4) {
+        uint8_t sib = p[(*i)++];
+        d->scale = sib >> 6;
+        int idx = ((sib >> 3) & 7) | (rexx << 3);
+        d->has_index = idx != 4;
+        d->index = idx;
+        d->base = (sib & 7) | (rexb << 3);
+        if ((sib & 7) == 5 && mod == 0) { d->has_base = 0; int32_t v; memcpy(&v, p + *i, 4); *i += 4; d->disp = v; }
+        else d->has_base = 1;
+    } else if (rm == 5 && mod == 0) {
+        int32_t v; memcpy(&v, p + *i, 4); *i += 4;
+        d->ripr = 1; d->disp = v;
+    } else { d->has_base = 1; d->base = rm | (rexb << 3); }
+    if (mod == 1) d->disp = (int8_t)p[(*i)++];
+    else if (mod == 2) { int32_t v; memcpy(&v, p + *i, 4); *i += 4; d->disp = v; }
+}
+
+static uint64_t effective_address(const AvxState *s, const Dec *d, const uint8_t *insn) {
+    if (d->ripr) return (uint64_t)(uintptr_t)(insn + d->len) + (uint64_t)s->ip_bias + (uint64_t)d->disp;
+    uint64_t ea = (uint64_t)d->disp;
+    if (d->has_base) ea += s->gpr[d->base];
+    if (d->has_index) ea += s->gpr[d->index] << d->scale;
+    return ea;
+}
