+    case 3: { static const uint32_t sp[] = {0, 0x80000000u, 0x7F800000u, 0xFF800000u, 0x7FC00000u, 0x3F800000u, 0x00000001u, 0xFFFFFFFFu, 0x7F7FFFFFu};
