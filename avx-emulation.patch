+/* Opcode families too regular for the table. */
+static int find_op(const Dec *d, Op *out) {
+    for (size_t i = 0; i < sizeof ops / sizeof *ops; ++i)
+        if (ops[i].map == d->map && ops[i].opc == d->opc && (ops[i].ppm & (1 << d->pp))) { *out = ops[i]; return 1; }
+    int o = d->opc;
+    memset(out, 0, sizeof *out);
+    out->map = (uint8_t)d->map; out->opc = (uint8_t)o; out->ms = 16;
+    if (d->pp != 1) return 0;
+    if (d->map == 1) {                                  /* 66 0F integer, NDS */
+        static const uint8_t list[] = {0x60,0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6A,0x6B,0x6C,0x6D,0x74,0x75,0x76,
+            0xD1,0xD2,0xD3,0xD4,0xD5,0xD8,0xD9,0xDA,0xDB,0xDC,0xDD,0xDE,0xDF,0xE0,0xE1,0xE2,0xE3,0xE4,0xE5,
+            0xE8,0xE9,0xEA,0xEB,0xEC,0xED,0xEE,0xEF,0xF1,0xF2,0xF3,0xF4,0xF5,0xF6,0xF8,0xF9,0xFA,0xFB,0xFC,0xFD,0xFE};
+        for (size_t i = 0; i < sizeof list; ++i) if (list[i] == o) { out->fl = F_NDS; return 1; }
+    } else if (d->map == 2) {
+        if (o <= 0x0B || o == 0x28 || o == 0x29 || o == 0x2B || (o >= 0x38 && o <= 0x40)) { out->fl = F_NDS; return 1; }
+        if (o == 0x1C || o == 0x1D || o == 0x1E || o == 0x2A) { out->fl = 0; return 1; }
+        static const uint8_t sz[6] = {8, 4, 2, 8, 4, 8};   /* bw bd bq wd wq dq */
+        if ((o >= 0x20 && o <= 0x25) || (o >= 0x30 && o <= 0x35)) { out->fl = 0; out->ms = sz[o & 7]; return 1; }
+    }
+    return 0;
+}
