diff -ruN a/scripts/avx_samples.py b/scripts/avx_samples.py
--- a/scripts/avx_samples.py	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/avx_samples.py	2026-10-31 10:53:35.327922529 +0000
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Lists every distinct AVX (VEX) and POPCNT/CRC32/PCMPGTQ instruction encoding in eboot.bin, one hex
+string per line, for tests/test_avx_emulate.c (which runs them on a CPU that has AVX and compares
+the emulator with the real thing). Needs binutils' objdump.   usage: avx_samples.py eboot.bin out.txt"""
+import subprocess, sys
+sys.path.insert(0, __file__.rsplit('/', 1)[0] if '/' in __file__ else '.')
+from prepare import parse_self
+
+elf = parse_self(open(sys.argv[1], 'rb').read())[0]
+program_headers = elf[0x40:0x40 + 56 * int.from_bytes(elf[0x38:0x3A], 'little')]
+text = None
+for i in range(0, len(program_headers), 56):
+    ptype, flags = int.from_bytes(program_headers[i:i+4], 'little'), int.from_bytes(program_headers[i+4:i+8], 'little')
+    if ptype == 1 and flags & 1:
+        offset, size = int.from_bytes(program_headers[i+8:i+16], 'little'), int.from_bytes(program_headers[i+32:i+40], 'little')
+        text = elf[offset:offset + size]
+        break
+import os
+text = text[:int(os.environ.get('AVX_SAMPLES_LIMIT', len(text)))]
+open('/tmp/avx_text.bin', 'wb').write(text)
+dis = subprocess.Popen(['objdump', '-D', '-b', 'binary', '-m', 'i386:x86-64', '-M', 'intel', '/tmp/avx_text.bin'],
+                       stdout=subprocess.PIPE, text=True).stdout
+seen, cur = set(), None
+
+def flush():
+    if cur:
+        data, mnemonic = cur
+        if data and data[0] in ('c4', 'c5') or mnemonic in ('popcnt', 'crc32', 'pcmpgtq'):
+            seen.add(''.join(data))
+
+for line in dis:
+    parts = line.rstrip('\n').split('\t')
+    if len(parts) >= 2 and parts[0].strip().endswith(':'):
+        if len(parts) >= 3 and parts[2].strip():
+            flush()
+            cur = (parts[1].split(), parts[2].split()[0])
+        elif cur:
+            cur[0].extend(parts[1].split())
+flush()
+open(sys.argv[2], 'w').write('\n'.join(sorted(seen)) + '\n')
+print(len(seen), 'distinct encodings')
