+/* Verifies src/avx_emulate.c against real AVX hardware: every instruction listed in the samples
+ * file (hex bytes, one per line; scripts/avx_samples.py makes it from eboot.bin) is run natively
+ * and through the emulator on the same random register/memory state, and the results are compared.
+ * Needs a host CPU with AVX + F16C. Linux only.
+ *   gcc -O1 -mno-red-zone -I src tests/test_avx_emulate.c -o out/avx-test && out/avx-test samples.txt */
+#define _GNU_SOURCE
+#include "../src/avx_emulate.c"
+#include <setjmp.h>
+#include <signal.h>
+#include <stdlib.h>
+
+typedef struct { uint64_t gpr[16]; uint8_t ymm[16][32]; uint64_t flags; uint32_t mxcsr, pad; } NState;
+void native_run(NState *st, const void *code);
