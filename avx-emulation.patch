+/* Verifies src/avx_emulate.c against real AVX hardware: every instruction listed in the samples
+ * file (hex bytes, one per line; scripts/avx_samples.py makes it from eboot.bin) is run natively
+ * and through the emulator on the same random register/memory state, and the results are compared.
+ * Needs a host CPU with AVX + F16C. Linux only.
+ *   gcc -O1 -mno-red-zone -I src tests/test_avx_emulate.c -o out/avx-test && out/avx-test samples.txt */
+#define _GNU_SOURCE
+#include "../src/avx_emulate.c"
+#include <setjmp.h>
+#include <signal.h>
+#include <stdlib.h>
+
+typedef struct { uint64_t gpr[16]; uint8_t ymm[16][32]; uint64_t flags; uint32_t mxcsr, pad; } NState;
+void native_run(NState *st, const void *code);
+__asm__(
+    ".text\n.globl native_run\nnative_run:\n"
+    "pushq %rbp\npushq %rbx\npushq %r12\npushq %r13\npushq %r14\npushq %r15\n"
+    "pushq %rdi\npushq %rsi\n"
+    "movq %rdi, %rax\n"
+#define LD(i) "vmovups " #i "*32+128(%rax), %ymm" #i "\n"
+    LD(0) LD(1) LD(2) LD(3) LD(4) LD(5) LD(6) LD(7) LD(8) LD(9) LD(10) LD(11) LD(12) LD(13) LD(14) LD(15)
+    "ldmxcsr 648(%rax)\n"
+    "pushq 640(%rax)\npopfq\n"
+    "movq 8(%rax),%rcx\nmovq 16(%rax),%rdx\nmovq 24(%rax),%rbx\nmovq 40(%rax),%rbp\nmovq 48(%rax),%rsi\nmovq 56(%rax),%rdi\n"
+    "movq 64(%rax),%r8\nmovq 72(%rax),%r9\nmovq 80(%rax),%r10\nmovq 88(%rax),%r11\n"
+    "movq 96(%rax),%r12\nmovq 104(%rax),%r13\nmovq 112(%rax),%r14\nmovq 120(%rax),%r15\n"
+    "movq 0(%rax),%rax\n"
+    "call *(%rsp)\n"
+    "pushq %rax\nmovq 16(%rsp),%rax\n"
+    "movq %rcx,8(%rax)\nmovq %rdx,16(%rax)\nmovq %rbx,24(%rax)\nmovq %rbp,40(%rax)\nmovq %rsi,48(%rax)\nmovq %rdi,56(%rax)\n"
+    "movq %r8,64(%rax)\nmovq %r9,72(%rax)\nmovq %r10,80(%rax)\nmovq %r11,88(%rax)\n"
+    "movq %r12,96(%rax)\nmovq %r13,104(%rax)\nmovq %r14,112(%rax)\nmovq %r15,120(%rax)\n"
+    "popq %rcx\nmovq %rcx,0(%rax)\n"
+#define ST(i) "vmovups %ymm" #i ", " #i "*32+128(%rax)\n"
+    ST(0) ST(1) ST(2) ST(3) ST(4) ST(5) ST(6) ST(7) ST(8) ST(9) ST(10) ST(11) ST(12) ST(13) ST(14) ST(15)
+    "stmxcsr 648(%rax)\npushfq\npopq 640(%rax)\nvzeroupper\n"
+    "addq $16,%rsp\n"
+    "popq %r15\npopq %r14\npopq %r13\npopq %r12\npopq %rbx\npopq %rbp\nret\n");
+
+static sigjmp_buf trap;
+static void on_signal(int sig) { (void)sig; siglongjmp(trap, 1); }
+
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint64_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return rng; }
+static uint32_t rnd32(void) {
+    switch (rnd() % 5) {
+    case 0: return (uint32_t)rnd();
+    case 1: { float f = (float)((int64_t)(rnd() % 200001) - 100000) / 100.0f; uint32_t u; memcpy(&u, &f, 4); return u; }
+    case 2: return (uint32_t)((int)(rnd() % 40) - 8);
+    case 3: { static const uint32_t sp[] = {0, 0x80000000u, 0x7F800000u, 0xFF800000u, 0x7FC00000u, 0x3F800000u, 0x00000001u, 0xFFFFFFFFu, 0x7F7FFFFFu};
+              return sp[rnd() % 9]; }
+    default: { float f = (float)((int64_t)(rnd() % 2001) - 1000) / 7.0f; uint32_t u; memcpy(&u, &f, 4); return u; }
+    }
+}
+static void fill(uint8_t *p, size_t n) {
+    for (size_t i = 0; i + 8 <= n; i += 8) {
+        if (rnd() & 1) { double x = (double)((int64_t)(rnd() % 2000001) - 1000000) / 1000.0; memcpy(p + i, &x, 8); }
+        else { uint32_t a = rnd32(), b = rnd32(); memcpy(p + i, &a, 4); memcpy(p + i + 4, &b, 4); }
+    }
+}
+
+typedef struct { const char *why; int n; char text[160]; } Reason;
+static Reason reasons[4000];
+static int nreasons;
+static void note(const char *why) {
+    char key[160]; snprintf(key, sizeof key, "%s", why);
+    char *colon = strchr(key, ':'); if (colon) { colon = strchr(colon + 1, ':'); if (colon) *colon = 0; }
+    /* group by message and the first bytes that identify the opcode */
+    char k2[160]; snprintf(k2, sizeof k2, "%s", why);
+    for (int i = 0; i < nreasons; ++i) if (!strncmp(reasons[i].text, k2, 40) && !strncmp(reasons[i].text, k2, strlen(k2) > 46 ? 46 : strlen(k2))) { reasons[i].n++; return; }
+    if (nreasons < 4000) { snprintf(reasons[nreasons].text, 160, "%s", k2); reasons[nreasons].n = 1; ++nreasons; }
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) { fprintf(stderr, "usage: avx-test samples.txt [rounds]\n"); return 2; }
+    const int rounds = argc > 2 ? atoi(argv[2]) : 3;
+    FILE *f = fopen(argv[1], "r");
+    if (!f) { perror("samples"); return 2; }
+    struct sigaction sa; memset(&sa, 0, sizeof sa); sa.sa_handler = on_signal; sa.sa_flags = SA_NODEFER;
+    sigaction(SIGSEGV, &sa, NULL); sigaction(SIGILL, &sa, NULL); sigaction(SIGBUS, &sa, NULL); sigaction(SIGFPE, &sa, NULL);
+
+    enum { BUF = 0x100000, MID = 0x80000, WIN_PRE = 64, WIN = 256 };
+    uint8_t *buf = aligned_alloc(4096, BUF);
+    fill(buf, BUF);
+    uint8_t *exec = mmap(NULL, 8192, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+
+    typedef struct { uint8_t code[16]; int n; Dec d; int need_mem; } Item;
+    Item *items = malloc(sizeof(Item) * 200000);
+    long nitems = 0;
+    long tested = 0, passed = 0, failed = 0, unsupported = 0, skipped = 0, native_fault = 0, samples = 0, mxdiff = 0;
+    char line[256];
+    int shown = 0;
+    while (fgets(line, sizeof line, f)) {
+        uint8_t code[24] = {0};
+        int n = 0;
+        for (char *q = line; *q && *q != '\n' && n < 15; q += 2) { unsigned v; if (sscanf(q, "%2x", &v) != 1) break; code[n++] = (uint8_t)v; }
+        if (!n) continue;
+        ++samples;
+        /* decode just enough to place memory operands */
+        Dec d; Op o; memset(&d, 0, sizeof d);
+        char why[160] = "";
+        int is_vex = code[0] == 0xC4 || code[0] == 0xC5;
+        int need_mem = 0;
+        if (is_vex) {
