+/* Entry of the AVX stubs (isa_rewrite.c, kind ISA_AVX). A rewritten AVX site jumps to a per-site
+ * stub that moves rsp below the System V red zone, then calls avx_stub_common (this file, assembly),
+ * which saves every guest register, calls the dispatch function and restores them.
+ * No exception is involved, so nothing overwrites the red zone (the Windows exception dispatcher
+ * does; that is what the fault-handler emulation in probe.c cannot avoid). */
+#ifndef BB_AVX_STUB_H
+#define BB_AVX_STUB_H
+#include <stdint.h>
+#include "isa_emulate.h"
+
+typedef struct {
+    uint8_t xmm[16][16];       /* +0:   xmm0..15 */
+    uint64_t gpr[16];          /* +256: x86 numbering; gpr[4] = the guest's rsp */
+    uint64_t rflags;           /* +384 */
+    uint32_t mxcsr, pad;       /* +392 */
+} AvxStubFrame;
+_Static_assert(sizeof(AvxStubFrame) == 400, "frame layout shared with the assembly in avx_stub.c");
+
+typedef void ABI (*AvxStubDispatch)(const IsaSite *site, AvxStubFrame *frame);
+
+/* The function avx_stub_common calls with (site, frame); it may change the frame, which is restored. */
+void avx_stub_set_dispatch(AvxStubDispatch dispatch);
+/* Address for isa_rewrite_set_avx. */
+const void *avx_stub_common_entry(void);
+
+#endif
