+            if (code[i] == 0x38 || code[i] == 0x3A) ++i;
+            ++i;
+            decode_modrm(code, &i, &d, rr, xx, bb);
+            if (map3) ++i;
+            need_mem = d.is_mem; d.len = i;
+            is_vex = 0;
+        }
+        if (need_mem) {
+            if (d.ripr == 0 && ((!d.has_base && !d.has_index) || (d.has_base && d.base == 4) || (d.has_base && d.has_index && d.base == d.index))) { ++skipped; continue; }
+            if (llabs(d.disp) > 0x70000) { ++skipped; continue; }
+        }
+        int strop = is_vex ? (o.id == S_PCMPSTR) : 0;
+        if (!is_vex) for (int k = 0; k + 2 < n; ++k) if (code[k] == 0x0F && code[k + 1] == 0x3A && code[k + 2] >= 0x60 && code[k + 2] <= 0x63) strop = 1;
+        uint8_t *at = exec;
+        int ripmap = 0;
+        if (d.ripr) {
+            uint64_t target = (uint64_t)(uintptr_t)(buf + MID);
+            uint64_t P = target - (uint64_t)d.len - (uint64_t)d.disp;
+            void *page = mmap((void *)(uintptr_t)(P & ~0xFFFull), 8192, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+            if (page == MAP_FAILED || (uint64_t)(uintptr_t)page != (P & ~0xFFFull)) { if (page != MAP_FAILED) munmap(page, 8192); ++skipped; continue; }
+            at = (uint8_t *)(uintptr_t)P; ripmap = 1;
+        }
+        memcpy(at, code, (size_t)n);
+        at[n] = 0xC3;
+        /* the native run executes the instruction then returns: place a ret right after it */
+        const long passed_before = passed;
+        for (int r = 0; r < rounds; ++r) {
+            NState ns; memset(&ns, 0, sizeof ns);
+            AvxState es; memset(&es, 0, sizeof es);
+            for (int g = 0; g < 16; ++g) ns.gpr[g] = rnd() & 1 ? rnd() : rnd() & 0xFFFF;
+            if (need_mem && !d.ripr) {
+                if (d.has_base) ns.gpr[d.base] = (uint64_t)(uintptr_t)(buf + MID);
+                if (d.has_index) ns.gpr[d.index] = 3;
+            }
+            for (int y = 0; y < 16; ++y) fill(ns.ymm[y], 32);
+            ns.flags = 0x202 | (rnd() & 0x8D5); ns.mxcsr = 0x1F80;
+            if (!is_vex || !need_mem) {}
+            uint64_t ea = 0;
+            if (need_mem) { AvxState tmp; memset(&tmp, 0, sizeof tmp); memcpy(tmp.gpr, ns.gpr, sizeof tmp.gpr); ea = effective_address(&tmp, &d, at); }
+            uint8_t *win = (uint8_t *)(uintptr_t)ea - WIN_PRE;
+            if (!need_mem) win = buf + MID;
+            fill(win, WIN);
+            if (strop) {
+                for (int g = 0; g < 16; ++g) if (g == 0 || g == 2) { int64_t v = (int64_t)(rnd() % 24) - 4; if (!(need_mem && !d.ripr && ((d.has_base && d.base == g) || (d.has_index && d.index == g)))) ns.gpr[g] = (uint64_t)v; }
+                const uint8_t alpha = (rnd() & 1) ? 3 : 7;
+                for (int y = 0; y < 16; ++y) for (int b = 0; b < 32; ++b) ns.ymm[y][b] = (uint8_t)((rnd() % 5 == 0) ? 0 : (rnd() & alpha));
+                for (int b = 0; b < WIN; ++b) win[b] = (uint8_t)((rnd() % 5 == 0) ? 0 : (rnd() & alpha));
+            }
+            uint8_t w0[WIN], wn[WIN], we[WIN];
+            memcpy(w0, win, WIN);
+            /* emulator state mirrors the native one */
+            memcpy(es.gpr, ns.gpr, sizeof es.gpr);
+            for (int y = 0; y < 16; ++y) { memcpy(es.xmm[y], ns.ymm[y], 16); memcpy(es.ymmh[y], ns.ymm[y] + 16, 16); }
+            es.rflags = ns.flags; es.mxcsr = ns.mxcsr;
+            AvxState e0 = es;
+            int len = avx_emulate(&es, at, why, sizeof why);
+            if (!len) { note(why); ++unsupported; break; }
+            memcpy(we, win, WIN);
+            memcpy(win, w0, WIN);
+            NState ns0 = ns;
+            if (sigsetjmp(trap, 1)) { ++native_fault; if (native_fault <= 12) { printf("NATIVE-FAULT "); for (int k = 0; k < n; ++k) printf("%02x", code[k]); printf(" ea=%llx\n", (unsigned long long)ea); } break; }
+            native_run(&ns, at);
+            memcpy(wn, win, WIN);
+            ++tested;
+            int bad = 0; char detail[200] = "";
+            for (int g = 0; g < 16 && !bad; ++g) if (g != 4 && ns.gpr[g] != es.gpr[g]) { bad = 1; snprintf(detail, sizeof detail, "gpr%d native=%016llx emu=%016llx", g, (unsigned long long)ns.gpr[g], (unsigned long long)es.gpr[g]); }
+            for (int y = 0; y < 16 && !bad; ++y) {
+                if (memcmp(ns.ymm[y], es.xmm[y], 16)) { bad = 1; snprintf(detail, sizeof detail, "ymm%d low differs", y); }
+                else if (memcmp(ns.ymm[y] + 16, es.ymmh[y], 16)) { bad = 1; snprintf(detail, sizeof detail, "ymm%d high differs", y); }
+            }
+            if (!bad && memcmp(wn, we, WIN)) { bad = 1; snprintf(detail, sizeof detail, "memory differs"); }
+            int fmask = 0;
+            if (is_vex && ((o.fl & F_NODST) || o.id == S_TESTPS || o.id == S_TESTPD)) fmask = 0x8D5;
+            if (is_vex && (o.id == S_ANDN || o.id == S_BLSX)) fmask = 0x8C1;
+            if (is_vex && o.id == S_BEXTR) fmask = 0x841;
+            if (strop) fmask = 0x8D5;
+            if (!is_vex) for (int k = 0; k + 1 < n; ++k) if (code[k] == 0x0F && code[k + 1] == 0xB8) fmask = 0x8D5;
+            if (!bad && fmask && ((ns.flags ^ es.rflags) & fmask)) { bad = 1; snprintf(detail, sizeof detail, "flags native=%llx emu=%llx", (unsigned long long)(ns.flags & fmask), (unsigned long long)(es.rflags & fmask)); }
+            if (!bad && ((ns.mxcsr ^ es.mxcsr) & 0x3F)) ++mxdiff;
+            (void)e0; (void)ns0;
+            if (bad) {
+                ++failed;
+                if (shown < 40) { ++shown; printf("MISMATCH "); for (int k = 0; k < n; ++k) printf("%02x", code[k]); printf(" : %s\n", detail); }
+                break;
+            }
+            ++passed;
+        }
+        if (passed - passed_before == rounds && is_vex && !d.ripr && nitems < 200000) {
+            Item *it = &items[nitems++];
+            memcpy(it->code, code, (size_t)n); it->n = n; it->d = d; it->need_mem = need_mem;
+        }
+        if (ripmap) munmap((void *)(uintptr_t)((uint64_t)(uintptr_t)at & ~0xFFFull), 8192);
+    }
+
+    /* Sequence test: random straight runs of the instructions that passed alone, run natively and
+     * through avx_emulate_run, which must consume the whole run in one call. */
+    long seq_tested = 0, seq_passed = 0, seq_failed = 0, seq_skipped = 0, seq_short = 0;
+    const int seq_count = argc > 3 ? atoi(argv[3]) : 20000;
+    for (int q = 0; q < seq_count && nitems > 1; ++q) {
+        int k = 2 + (int)(rnd() % 7);
+        Item *pick[8];
+        int role[16] = {0}, bad_roles = 0;
+        for (int i = 0; i < k && !bad_roles; ++i) {
+            pick[i] = &items[rnd() % (uint64_t)nitems];
+            const Dec *dd = &pick[i]->d;
+            if (!pick[i]->need_mem) continue;
+            if (dd->has_base) { if (role[dd->base] == 2) bad_roles = 1; role[dd->base] = 1; }
+            if (dd->has_index) { if (role[dd->index] == 1) bad_roles = 1; role[dd->index] = 2; }
+            if (dd->has_base && dd->has_index && dd->base == dd->index) bad_roles = 1;
+        }
+        if (bad_roles) { ++seq_skipped; continue; }
+        uint8_t seq[256]; int total = 0;
+        for (int i = 0; i < k; ++i) { memcpy(seq + total, pick[i]->code, (size_t)pick[i]->n); total += pick[i]->n; }
+        seq[total] = 0xC3;
+        memcpy(exec, seq, (size_t)total + 1);
+        NState ns; memset(&ns, 0, sizeof ns);
+        for (int g = 0; g < 16; ++g) ns.gpr[g] = role[g] == 1 ? (uint64_t)(uintptr_t)(buf + MID) : role[g] == 2 ? 3 : (rnd() & 1 ? rnd() : rnd() & 0xFFFF);
+        for (int y = 0; y < 16; ++y) fill(ns.ymm[y], 32);
+        ns.flags = 0x202 | (rnd() & 0x8D5); ns.mxcsr = 0x1F80;
+        AvxState es; memset(&es, 0, sizeof es);
+        memcpy(es.gpr, ns.gpr, sizeof es.gpr);
+        for (int y = 0; y < 16; ++y) { memcpy(es.xmm[y], ns.ymm[y], 16); memcpy(es.ymmh[y], ns.ymm[y] + 16, 16); }
+        es.rflags = ns.flags; es.mxcsr = ns.mxcsr;
+        /* memory span the run can touch */
+        uint64_t lo = ~0ull, hi = 0;
+        for (int i = 0; i < k; ++i) if (pick[i]->need_mem) {
+            uint64_t ea = effective_address(&es, &pick[i]->d, exec);
+            if (ea < lo) lo = ea;
+            if (ea + 32 > hi) hi = ea + 32;
+        }
+        if (lo == ~0ull) { lo = (uint64_t)(uintptr_t)(buf + MID); hi = lo + 32; }
+        lo -= 64; hi += 64;
+        if (hi - lo > 8192) { ++seq_skipped; continue; }
+        uint8_t m0[8192], mn[8192], me[8192];
+        const size_t span = (size_t)(hi - lo);
+        fill((uint8_t *)(uintptr_t)lo, span & ~7ull);
+        memcpy(m0, (void *)(uintptr_t)lo, span);
+        char why[160] = "";
+        int cnt = 0;
+        int used = avx_emulate_run(&es, exec, 256, &cnt, why, sizeof why);
+        memcpy(me, (void *)(uintptr_t)lo, span);
+        memcpy((void *)(uintptr_t)lo, m0, span);
+        if (used != total || cnt != k) { ++seq_short; if (seq_short <= 5) { printf("SEQ-SHORT used %d of %d, %d of %d insns: ", used, total, cnt, k); for (int i = 0; i < total; ++i) printf("%02x", seq[i]); printf(" %s\n", why); } continue; }
+        if (sigsetjmp(trap, 1)) { ++seq_skipped; continue; }
+        native_run(&ns, exec);
+        memcpy(mn, (void *)(uintptr_t)lo, span);
+        ++seq_tested;
+        int bad = 0;
+        for (int g = 0; g < 16 && !bad; ++g) if (g != 4 && ns.gpr[g] != es.gpr[g]) bad = 1;
+        for (int y = 0; y < 16 && !bad; ++y) if (memcmp(ns.ymm[y], es.xmm[y], 16) || memcmp(ns.ymm[y] + 16, es.ymmh[y], 16)) bad = 1;
+        if (!bad && memcmp(mn, me, span)) bad = 1;
+        if (bad) { ++seq_failed; if (seq_failed <= 10) { printf("SEQ-MISMATCH "); for (int i = 0; i < total; ++i) printf("%02x", seq[i]); printf("\n"); } }
+        else ++seq_passed;
+    }
+    printf("sequences: tested %ld  passed %ld  failed %ld  short %ld  skipped %ld\n", seq_tested, seq_passed, seq_failed, seq_short, seq_skipped);
+    failed += seq_failed;
+    printf("samples %ld  tested-rounds %ld  passed %ld  failed %ld  unsupported %ld  skipped %ld  native-fault %ld  mxcsr-flag-diffs %ld\n",
+           samples, tested, passed, failed, unsupported, skipped, native_fault, mxdiff);
+    for (int i = 0; i < nreasons; ++i) printf("  %5d x %s\n", reasons[i].n, reasons[i].text);
+    return failed ? 1 : 0;
+}
diff --git a/tests/test_avx_rewrite.py b/tests/test_avx_rewrite.py
new file mode 100644
index 0000000..4e90d5c
--- /dev/null
+++ b/tests/test_avx_rewrite.py
@@ -0,0 +1,50 @@
+"""Plan logic and table encoding of scripts/avx_rewrite.py (no iced-x86 needed).  python3 tests/test_avx_rewrite.py"""
+import sys, struct
+sys.path.insert(0, 'scripts')
+import avx_rewrite as r
+
+def I(ip, n, emu=False, plain=False, target=False):
+    return r.Insn(ip, bytes([0xC5 if emu else 0x90]) * n, emu, plain, target)
+
+# run of three VEX insns (12 bytes) -> one site
+s = r.plan([I(0, 4, True), I(4, 4, True), I(8, 4, True), I(12, 1, plain=True)]); assert [(x.offset, x.n_insn, x.reloc) for x in s] == [(0, 3, b'')]
+# lone 4-byte VEX + plain next -> relocated
+s = r.plan([I(0, 4, True), I(4, 2, plain=True)]); assert len(s) == 1 and s[0].reloc == b'\x90\x90'
+# lone 4-byte VEX, next is not plain -> skipped
+assert r.plan([I(0, 4, True), I(4, 2)]) == []
+# lone 4-byte VEX, next plain but a branch target -> skipped
+assert r.plan([I(0, 4, True), I(4, 2, plain=True, target=True)]) == []
+# branch target inside a run splits it: [0..8) then [8..)
+s = r.plan([I(0, 4, True), I(4, 4, True), I(8, 4, True, target=True), I(12, 4, True)]); assert [(x.offset, x.n_insn) for x in s] == [(0, 2), (8, 2)]
+# a gap between instructions (data in code) ends the run
+s = r.plan([I(0, 4, True), I(5, 4, True)]); assert s == []
+# more than 32 bytes splits
+s = r.plan([I(i * 5, 5, True) for i in range(10)]); assert [(x.n_insn, len(x.emu)) for x in s] == [(6, 30), (4, 20)]
+img = bytes(range(256))
+t = r.encode_table(img, [r.Site(8, b'\xc5' * 8, 2, b'')])
+assert len(t) == 64 + 64 and t[:8] == b'BBAVX1\0\0' and struct.unpack_from('<I', t, 48)[0] == 1
+open('/tmp/avx_table_test.bin', 'wb').write(t)
+print('ok')
+
+# --- jump-target sources beyond direct branches -------------------------------------------------------------
+import struct as st
+# relative jump table at 0x100: three int32 entries pointing into code [0x1000, 0x2000), then a value outside it
+img = bytearray(0x200)
+for k, tgt in enumerate((0x1010, 0x1234, 0x1ff0, 0x9000)):
+    st.pack_into('<i', img, 0x100 + 4 * k, tgt - 0x100)
+in_code = lambda x: 0x1000 <= x < 0x2000
+assert r.table_targets(bytes(img), 0x100, in_code) == [0x1010, 0x1234, 0x1ff0]
+assert r.table_targets(bytes(img), 0x0, in_code) == []                   # not a table
+assert r.table_targets(bytes(img), 0x1fe, in_code) == []                 # runs off the image
+
+# relocation table: BBPROBE5 layout (header, procparam, main TLS, modules, bindings, segments, imports, relocs)
+ns, nr, ni = 2, 3, 1
+blob = bytearray(st.pack('<8s6Q', b'BBPROBE5', 0x300, 0x80, ns, nr, ni, 0))
+blob += bytes(8 + 32)                                    # procparam, main TLS
+blob += st.pack('<Q', 1) + bytes(56)                     # one module
+blob += st.pack('<Q', 2) + bytes(48)                     # two bindings
+blob += bytes(ns * 24) + bytes(ni * 128)
+for target, kind, value, addend in ((0x10, 0, 0x1500, 0), (0x18, 1, 7, 0), (0x20, 0, 0x1800, 0)):
+    blob += st.pack('<4Q', target, kind, value, addend)
+assert r.read_relocs(bytes(blob)) == [0x1500, 0x1800]
+print('ok (targets)')
diff --git a/tests/test_avx_stub.c b/tests/test_avx_stub.c
new file mode 100644
index 0000000..667b946
--- /dev/null
+++ b/tests/test_avx_stub.c
@@ -0,0 +1,66 @@
+/* Verifies src/avx_stub.c on a CPU with AVX (Linux): a leaf function that keeps data in its 128-byte
+ * red zone and runs a VEX run is executed natively and, as a copy patched with avx_stub_apply, through
+ * the stub + emulator. Return value (red zone data, flags, caller-saved regs) and the stored vectors
+ * must match.
+ *   gcc -std=gnu11 -O1 -mno-red-zone -no-pie -I src tests/test_avx_stub.c src/avx_stub.c src/isa_rewrite.c -lm -o out/avx-stub-test */
+#define _GNU_SOURCE
+#include "../src/avx_emulate.c"
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include "../src/avx_stub.h"
+
+/* %rdi, %rsi: red zone words; %rdx: output; %rcx: input (64 bytes).  The VEX run sits between run_N_s and run_N_e. */
+#define FN(N, PRE, POST, LD1, RIP)                                                                   \
+    __asm__(".text\n.globl fn" #N "\nfn" #N ":\n" PRE                                           \
+            "movq %rdi,-8(%rsp)\nmovq %rsi,-0x80(%rsp)\nmovq %rdi,%r10\nmovq %rsi,%r11\nstc\n"  \
+            ".globl run_" #N "_s\nrun_" #N "_s:\n"                                              \
+            LD1 "vmovups 32(%rcx),%ymm2\n" RIP                               \
+            "vaddps %ymm1,%ymm2,%ymm3\nvmulps %ymm3,%ymm1,%ymm0\n"                              \
+            "vmovups %ymm3,0(%rdx)\nvmovups %ymm0,32(%rdx)\n"                                   \
+            ".globl run_" #N "_e\nrun_" #N "_e:\n"                                              \
+            "movq -8(%rsp),%rax\nadcq -0x80(%rsp),%rax\naddq %r10,%rax\nxorq %r11,%rax\n" POST  \
+            "ret\n.globl end_" #N "\nend_" #N ":\n.balign 32\n.globl data_" #N "\ndata_" #N ":\n" \
+            ".float 1.5,2.5,3.5,4.5,5.5,6.5,7.5,8.5\n");
+#define L1 "vmovups 0(%rcx),%ymm1\n"
+FN(0, "", "", L1, "")
+FN(1, "pushq %rbp\n", "popq %rbp\n", L1, "")
+FN(2, "", "", "", "vmovups data_2(%rip),%ymm1\n")
+typedef uint64_t (*Fn)(uint64_t, uint64_t, void *, const void *);
+extern char fn0[], run_0_s[], run_0_e[], end_0[], fn1[], run_1_s[], run_1_e[], end_1[], fn2[], run_2_s[], run_2_e[], end_2[];
+
+static int run_case(int n, char *fn, char *rs, char *re, char *en, int n_insn) {
+    float in[16], o1[16], o2[16];
+    for (int i = 0; i < 16; ++i) in[i] = (float)(i * 3 + 1) * 0.37f, o1[i] = o2[i] = 0;
+    uint64_t native = ((Fn)fn)(0x1122334455667788ull, 0x99aabbccddeeff00ull, o1, in);
+    size_t fl = (size_t)(en - fn) + 64;                          /* code + data after it */
+    unsigned char *region = mmap((void *)0x10000000, 1 << 20, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+    if (region == MAP_FAILED) { perror("mmap"); return 1; }
+    unsigned char *image = region, *stubs = region + 0x10000;
+    memcpy(image, fn, fl);
+    AvxSite site; memset(&site, 0, sizeof site);
+    site.offset = (uint64_t)(rs - fn); site.emu_len = (uint8_t)(re - rs); site.n_insn = (uint8_t)n_insn;
+    memcpy(site.emu, rs, site.emu_len);
+    AvxTable t; memset(&t, 0, sizeof t); t.sites = &site; t.count = 1; t.image_size = 0x10000;
+    unsigned char before[64]; memcpy(before, image + site.offset, site.emu_len);
+    uint32_t done = avx_stub_apply(&t, image, stubs);
+    if (memcmp(before + 5, image + site.offset + 5, site.emu_len - 5)) { puts("interior bytes were modified"); return 1; }
+    uint64_t stub = ((Fn)image)(0x1122334455667788ull, 0x99aabbccddeeff00ull, o2, in);
+    int bad = done != 1 || native != stub || memcmp(o1, o2, sizeof o1);
+    printf("case %d: rewritten=%u emu_len=%u native=%016llx stub=%016llx vectors %s -> %s\n", n, done, site.emu_len,
+           (unsigned long long)native, (unsigned long long)stub, memcmp(o1, o2, sizeof o1) ? "DIFFER" : "equal", bad ? "FAIL" : "ok");
+    munmap(region, 1 << 20);
+    return bad;
+}
+
+static uint8_t shadow[256];
+static void *get_shadow(void) { return shadow; }
+int main(void) {
+    avx_stub_set_hooks(get_shadow, NULL);
+    int bad = 0;
+    bad |= run_case(0, fn0, run_0_s, run_0_e, end_0, 6);
+    bad |= run_case(1, fn1, run_1_s, run_1_e, end_1, 6);
+    bad |= run_case(2, fn2, run_2_s, run_2_e, end_2, 6);
+    puts(bad ? "FAILED" : "ALL OK");
+    return bad;
+}
