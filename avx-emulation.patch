+/* ------------------------------------------------------------------------------------------ */
+/* Decoder                                                                                      */
+/* ------------------------------------------------------------------------------------------ */
+typedef struct {
+    int map, pp, L, W, vvvv, opc;
+    int reg, rm;                 /* extended register numbers (rm: register form only) */
+    int ext;                     /* modrm.reg low 3 bits (opcode extension) */
+    int is_mem, has_base, has_index, ripr, base, index, scale;
+    int64_t disp;
+    int has_imm; uint8_t imm;
+    int len;
+} Dec;
+
+static int fail(char *why, size_t n, const uint8_t *p, const char *msg) {
+    if (why && n) snprintf(why, n, "%s: %02x %02x %02x %02x %02x %02x %02x %02x", msg, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    return 0;
+}
+
+/* Decodes modrm/sib/disp at p[*i]; rexr/rexx/rexb are the 0/1 extension bits. */
+static void decode_modrm(const uint8_t *p, int *i, Dec *d, int rexr, int rexx, int rexb) {
+    uint8_t m = p[(*i)++];
+    int mod = m >> 6, rm = m & 7;
+    d->ext = (m >> 3) & 7;
+    d->reg = d->ext | (rexr << 3);
+    if (mod == 3) { d->is_mem = 0; d->rm = rm | (rexb << 3); return; }
+    d->is_mem = 1;
+    if (rm == 4) {
+        uint8_t sib = p[(*i)++];
+        d->scale = sib >> 6;
+        int idx = ((sib >> 3) & 7) | (rexx << 3);
+        d->has_index = idx != 4;
+        d->index = idx;
+        d->base = (sib & 7) | (rexb << 3);
+        if ((sib & 7) == 5 && mod == 0) { d->has_base = 0; int32_t v; memcpy(&v, p + *i, 4); *i += 4; d->disp = v; }
+        else d->has_base = 1;
+    } else if (rm == 5 && mod == 0) {
+        int32_t v; memcpy(&v, p + *i, 4); *i += 4;
+        d->ripr = 1; d->disp = v;
+    } else { d->has_base = 1; d->base = rm | (rexb << 3); }
+    if (mod == 1) d->disp = (int8_t)p[(*i)++];
+    else if (mod == 2) { int32_t v; memcpy(&v, p + *i, 4); *i += 4; d->disp = v; }
+}
+
+static uint64_t effective_address(const AvxState *s, const Dec *d, const uint8_t *insn) {
+    if (d->ripr) return (uint64_t)(uintptr_t)(insn + d->len) + (uint64_t)d->disp;
+    uint64_t ea = (uint64_t)d->disp;
+    if (d->has_base) ea += s->gpr[d->base];
+    if (d->has_index) ea += s->gpr[d->index] << d->scale;
+    return ea;
+}
