+/* ------------------------------------------------------------------------------------------ */
+/* Portable C: instructions with no legacy twin                                                 */
+/* ------------------------------------------------------------------------------------------ */
+static float half_to_float_bits(uint16_t h, uint32_t *bits) {
+    uint32_t sign = (uint32_t)(h & 0x8000) << 16, exp = (h >> 10) & 0x1F, man = h & 0x3FF, out;
+    if (exp == 0) {
+        if (!man) out = sign;
+        else { int e = -1; do { ++e; man <<= 1; } while (!(man & 0x400)); man &= 0x3FF; out = sign | ((uint32_t)(112 - e) << 23) | (man << 13); }
+    } else if (exp == 31) out = sign | 0x7F800000u | (man << 13) | (man ? 0x400000u : 0);
+    else out = sign | ((exp + 112) << 23) | (man << 13);
+    *bits = out;
+    return 0;
+}
+
+/* rc: 0 nearest-even, 1 down, 2 up, 3 truncate. */
+static uint16_t float_to_half(uint32_t f, int rc) {
+    uint32_t sign = (f >> 16) & 0x8000, exp = (f >> 23) & 0xFF, man = f & 0x7FFFFF;
+    const int neg = sign != 0;
+    if (exp == 0xFF) return man ? (uint16_t)(sign | 0x7E00 | (man >> 13)) : (uint16_t)(sign | 0x7C00);
+    int inexact_up = (rc == 2 && !neg) || (rc == 1 && neg);       /* directed rounding away from zero */
+    if (exp == 0) {                                                /* zero or float denormal: far below half's range */
+        if (!man) return (uint16_t)sign;
+        return (uint16_t)(sign | (inexact_up ? 1 : 0));
+    }
+    int e = (int)exp - 127;
+    if (e > 15) return (uint16_t)(sign | (rc == 0 || inexact_up ? 0x7C00 : 0x7BFF));
+    uint32_t q; int cmp, inexact;
+    if (e >= -14) {
+        uint32_t rem = man & 0x1FFF;
+        q = ((uint32_t)(e + 15) << 10) | (man >> 13);
+        cmp = rem < 0x1000 ? -1 : rem == 0x1000 ? 0 : 1;
+        inexact = rem != 0;
+    } else {
+        uint32_t total = man | 0x800000u;
+        int shift = -(e + 1);
+        if (shift > 40) { q = 0; cmp = -1; inexact = 1; }
+        else {
+            uint64_t rem = (uint64_t)total & (((uint64_t)1 << shift) - 1), halfpt = (uint64_t)1 << (shift - 1);
+            q = (uint32_t)((uint64_t)total >> shift);
+            cmp = rem < halfpt ? -1 : rem == halfpt ? 0 : 1;
+            inexact = rem != 0;
+        }
+    }
+    if (inexact) {
+        if (rc == 0) { if (cmp > 0 || (cmp == 0 && (q & 1))) ++q; }
+        else if (inexact_up) ++q;
+    }
+    return (uint16_t)(sign | q);
+}
+
+
+/* AES (the host has no AES-NI) ---------------------------------------------------------------- */
+static uint8_t aes_sbox[256], aes_isbox[256];
+static volatile int aes_ready;
+static uint8_t gmul(uint8_t a, uint8_t b) {
+    uint8_t p = 0;
+    for (int i = 0; i < 8; ++i) { if (b & 1) p ^= a; uint8_t hi = a & 0x80; a = (uint8_t)(a << 1); if (hi) a ^= 0x1B; b >>= 1; }
+    return p;
+}
+static uint8_t rotl8(uint8_t v, int n) { return (uint8_t)((v << n) | (v >> (8 - n))); }
+static void aes_init(void) {
+    if (__atomic_load_n(&aes_ready, __ATOMIC_ACQUIRE)) return;
+    for (int x = 0; x < 256; ++x) {
+        uint8_t inv = 0;
+        if (x) for (int y = 1; y < 256; ++y) if (gmul((uint8_t)x, (uint8_t)y) == 1) { inv = (uint8_t)y; break; }
+        uint8_t v = (uint8_t)(inv ^ rotl8(inv, 1) ^ rotl8(inv, 2) ^ rotl8(inv, 3) ^ rotl8(inv, 4) ^ 0x63);
+        aes_sbox[x] = v; aes_isbox[v] = (uint8_t)x;
+    }
+    __atomic_store_n(&aes_ready, 1, __ATOMIC_RELEASE);
+}
+static void aes_shift_rows(uint8_t *st, int inv) {
+    uint8_t t[16];
+    for (int r = 0; r < 4; ++r) for (int c = 0; c < 4; ++c) {
+        if (!inv) t[r + 4 * c] = st[r + 4 * ((c + r) & 3)]; else t[r + 4 * ((c + r) & 3)] = st[r + 4 * c];
+    }
+    memcpy(st, t, 16);
+}
+static void aes_sub(uint8_t *st, int inv) { for (int i = 0; i < 16; ++i) st[i] = inv ? aes_isbox[st[i]] : aes_sbox[st[i]]; }
+static void aes_mix(uint8_t *st, int inv) {
+    static const uint8_t m[2][4] = {{2, 3, 1, 1}, {14, 11, 13, 9}};
+    for (int c = 0; c < 4; ++c) {
+        uint8_t a[4], r[4];
+        memcpy(a, st + 4 * c, 4);
+        for (int i = 0; i < 4; ++i) {
+            r[i] = 0;
+            for (int j = 0; j < 4; ++j) r[i] ^= gmul(a[j], m[inv][(j - i + 4) & 3]);
+        }
+        memcpy(st + 4 * c, r, 4);
+    }
+}
+static void set_flags_bmi(AvxState *s, int cf, int zf, int sf) {
+    s->rflags = (s->rflags & ~0x8C1ull) | (cf ? 1ull : 0) | (zf ? 0x40ull : 0) | (sf ? 0x80ull : 0);
+}
+
+/* SSE4.2 string compare (pcmpestri/pcmpestrm/pcmpistri/pcmpistrm), legacy and VEX ---------------- */
+static int str_elem(const uint8_t *p, int i, int words, int sgn) {
+    if (words) { uint16_t v; memcpy(&v, p + 2 * i, 2); return sgn ? (int16_t)v : (int)v; }
+    return sgn ? (int8_t)p[i] : (int)p[i];
+}
+static int exec_pcmpstr(AvxState *s, const Dec *d, uint64_t ea, int opc, uint8_t imm, int vex) {
+    const int explicit_len = opc == 0x60 || opc == 0x61, index_out = opc == 0x61 || opc == 0x63;
+    const int words = imm & 1, sgn = (imm >> 1) & 1, agg = (imm >> 2) & 3, pol = (imm >> 4) & 3, msb = (imm >> 6) & 1;
+    const int n = words ? 8 : 16;
+    uint8_t A[16], B[16];
+    memcpy(A, s->xmm[d->reg], 16);
+    get_rm(s, d, ea, 16, B);
+    int la = n, lb = n;
+    if (explicit_len) {
+        int64_t ra = d->W ? (int64_t)s->gpr[0] : (int64_t)(int32_t)s->gpr[0];
+        int64_t rb = d->W ? (int64_t)s->gpr[2] : (int64_t)(int32_t)s->gpr[2];
+        if (ra < 0) ra = -ra;
+        if (rb < 0) rb = -rb;
+        la = ra > n ? n : (int)ra;
+        lb = rb > n ? n : (int)rb;
+    } else {
+        for (la = 0; la < n && str_elem(A, la, words, 0); ++la) {}
+        for (lb = 0; lb < n && str_elem(B, lb, words, 0); ++lb) {}
+    }
+    int bres[16][16];                       /* [index into A][index into B] */
+    for (int i = 0; i < n; ++i)
+        for (int j = 0; j < n; ++j) {
+            const int av = i < la, bv = j < lb;
+            int v;
+            if (!av && !bv) v = agg == 2 || agg == 3;
+            else if (av && !bv) v = 0;
+            else if (!av && bv) v = agg == 3;
+            else {
+                int a = str_elem(A, i, words, sgn), b = str_elem(B, j, words, sgn);
+                v = agg == 1 ? ((i & 1) ? b <= a : b >= a) : a == b;
+            }
+            bres[i][j] = v;
+        }
+    int res1[16];
+    for (int j = 0; j < n; ++j) {
+        int r = 0;
+        if (agg == 0) { for (int i = 0; i < n; ++i) r |= bres[i][j]; }
+        else if (agg == 1) { for (int i = 0; i + 1 < n; i += 2) r |= bres[i][j] && bres[i + 1][j]; }
+        else if (agg == 2) r = bres[j][j];
+        else { r = 1; for (int k = j, i = 0; k < n; ++k, ++i) r &= bres[i][k]; }
+        res1[j] = r;
+    }
+    uint32_t m = 0;
+    for (int j = 0; j < n; ++j) {
+        int r = res1[j];
+        if (pol == 1) r = !r;
+        else if (pol == 3) r = j < lb ? !r : r;
+        m |= (uint32_t)r << j;
+    }
+    if (index_out) s->gpr[1] = m ? (uint64_t)(msb ? 31 - __builtin_clz(m) : __builtin_ctz(m)) : (uint64_t)n;
+    else {
+        uint8_t out[16] = {0};
+        if (!msb) memcpy(out, &m, 2);
+        else for (int j = 0; j < n; ++j) if ((m >> j) & 1) { if (words) { out[2 * j] = 0xFF; out[2 * j + 1] = 0xFF; } else out[j] = 0xFF; }
+        memcpy(s->xmm[0], out, 16);
+        if (vex) memset(s->ymmh[0], 0, 16);
+    }
+    s->rflags = (s->rflags & ~0x8D5ull) | (m ? 1ull : 0) | (lb < n ? 0x40ull : 0) | (la < n ? 0x80ull : 0) | ((m & 1) ? 0x800ull : 0);
+    return 1;
+}
+
+static int exec_soft(AvxState *s, const Dec *d, const Op *o, uint64_t ea) {
+    const int nb = d->L ? 32 : 16;
+    uint8_t a[32] = {0}, b[32] = {0}, out[32] = {0};
+    const uint8_t imm = d->imm;
+    switch (o->id) {
+    case S_INSERTF128:
+        if (!d->L) return 0;
+        get_vec(s, d->vvvv, 32, a); get_rm(s, d, ea, 16, b);
+        memcpy(a + ((imm & 1) ? 16 : 0), b, 16);
+        set_vec(s, d->reg, 32, a);
+        return 1;
+    case S_EXTRACTF128:
+        if (!d->L) return 0;
+        get_vec(s, d->reg, 32, a);
+        if (d->is_mem) memcpy((void *)(uintptr_t)ea, a + ((imm & 1) ? 16 : 0), 16);
+        else { memcpy(s->xmm[d->rm], a + ((imm & 1) ? 16 : 0), 16); memset(s->ymmh[d->rm], 0, 16); }
+        return 1;
+    case S_PERM2F128:
+        if (!d->L) return 0;
+        get_vec(s, d->vvvv, 32, a); get_rm(s, d, ea, 32, b);
+        for (int i = 0; i < 2; ++i) {
+            int ctl = (imm >> (4 * i)) & 0xF;
+            if (ctl & 8) memset(out + 16 * i, 0, 16);
+            else memcpy(out + 16 * i, ((ctl & 2) ? b : a) + 16 * (ctl & 1), 16);
+        }
+        set_vec(s, d->reg, 32, out);
+        return 1;
+    case S_BCASTSS: {
+        uint32_t v;
+        if (d->is_mem) memcpy(&v, (const void *)(uintptr_t)ea, 4); else memcpy(&v, s->xmm[d->rm], 4);
+        for (int i = 0; i < nb / 4; ++i) memcpy(out + 4 * i, &v, 4);
+        set_vec(s, d->reg, nb, out);
+        return 1; }
+    case S_BCASTSD: {
+        if (!d->L) return 0;
+        uint64_t v;
+        if (d->is_mem) memcpy(&v, (const void *)(uintptr_t)ea, 8); else memcpy(&v, s->xmm[d->rm], 8);
+        for (int i = 0; i < 4; ++i) memcpy(out + 8 * i, &v, 8);
+        set_vec(s, d->reg, 32, out);
+        return 1; }
+    case S_BCASTF128:
+        if (!d->L || !d->is_mem) return 0;
+        memcpy(a, (const void *)(uintptr_t)ea, 16);
+        memcpy(out, a, 16); memcpy(out + 16, a, 16);
+        set_vec(s, d->reg, 32, out);
+        return 1;
+    case S_PERMILPS_IMM:
+        get_rm(s, d, ea, nb, a);
+        for (int l = 0; l < nb / 16; ++l)
+            for (int i = 0; i < 4; ++i) memcpy(out + 16 * l + 4 * i, a + 16 * l + 4 * ((imm >> (2 * i)) & 3), 4);
+        set_vec(s, d->reg, nb, out);
+        return 1;
+    case S_PERMILPD_IMM:
+        get_rm(s, d, ea, nb, a);
+        for (int l = 0; l < nb / 16; ++l)
+            for (int j = 0; j < 2; ++j) memcpy(out + 16 * l + 8 * j, a + 16 * l + 8 * ((imm >> (2 * l + j)) & 1), 8);
+        set_vec(s, d->reg, nb, out);
+        return 1;
+    case S_PERMILPS_VAR:
+        get_vec(s, d->vvvv, nb, a); get_rm(s, d, ea, nb, b);
+        for (int l = 0; l < nb / 16; ++l)
+            for (int i = 0; i < 4; ++i) {
+                uint32_t c; memcpy(&c, b + 16 * l + 4 * i, 4);
+                memcpy(out + 16 * l + 4 * i, a + 16 * l + 4 * (c & 3), 4);
+            }
+        set_vec(s, d->reg, nb, out);
+        return 1;
+    case S_PERMILPD_VAR:
+        get_vec(s, d->vvvv, nb, a); get_rm(s, d, ea, nb, b);
+        for (int l = 0; l < nb / 16; ++l)
+            for (int j = 0; j < 2; ++j) {
+                uint64_t c; memcpy(&c, b + 16 * l + 8 * j, 8);
+                memcpy(out + 16 * l + 8 * j, a + 16 * l + 8 * ((c >> 1) & 1), 8);
+            }
+        set_vec(s, d->reg, nb, out);
+        return 1;
+    case S_TESTPS: case S_TESTPD: {
+        const int w = o->id == S_TESTPS ? 4 : 8;
+        get_vec(s, d->reg, nb, a); get_rm(s, d, ea, nb, b);
+        int zf = 1, cf = 1;
+        for (int i = 0; i < nb; i += w) {
+            int sa = (a[i + w - 1] >> 7) & 1, sb = (b[i + w - 1] >> 7) & 1;
+            if (sa & sb) zf = 0;
+            if (!sa && sb) cf = 0;
+        }
+        s->rflags = (s->rflags & ~0x8D5ull) | (zf ? 0x40ull : 0) | (cf ? 1ull : 0);
+        return 1; }
+    case S_MASKLD_PS: case S_MASKLD_PD: {
+        const int w = o->id == S_MASKLD_PS ? 4 : 8;
+        get_vec(s, d->vvvv, nb, a);
+        if (!d->is_mem) return 0;
+        for (int i = 0; i < nb; i += w)
+            if (a[i + w - 1] & 0x80) memcpy(out + i, (const void *)(uintptr_t)(ea + (unsigned)i), (size_t)w);
+        set_vec(s, d->reg, nb, out);
+        return 1; }
+    case S_MASKST_PS: case S_MASKST_PD: {
+        const int w = o->id == S_MASKST_PS ? 4 : 8;
+        get_vec(s, d->vvvv, nb, a); get_vec(s, d->reg, nb, b);
+        if (!d->is_mem) return 0;
+        for (int i = 0; i < nb; i += w)
+            if (a[i + w - 1] & 0x80) memcpy((void *)(uintptr_t)(ea + (unsigned)i), b + i, (size_t)w);
+        return 1; }
+    case S_CVTPH2PS: {
+        const int n = d->L ? 8 : 4;
+        get_rm(s, d, ea, n * 2, a);
+        for (int i = 0; i < n; ++i) { uint16_t h; memcpy(&h, a + 2 * i, 2); uint32_t f; half_to_float_bits(h, &f); memcpy(out + 4 * i, &f, 4); }
+        set_vec(s, d->reg, d->L ? 32 : 16, out);
+        return 1; }
+    case S_CVTPS2PH: {
+        const int n = d->L ? 8 : 4;
+        get_vec(s, d->reg, nb, a);
+        const int rc = (imm & 4) ? (int)((s->mxcsr >> 13) & 3) : (imm & 3);
+        for (int i = 0; i < n; ++i) { uint32_t f; memcpy(&f, a + 4 * i, 4); uint16_t h = float_to_half(f, rc); memcpy(out + 2 * i, &h, 2); }
+        if (d->is_mem) memcpy((void *)(uintptr_t)ea, out, (size_t)n * 2);
+        else { memcpy(s->xmm[d->rm], out, 16); memset(s->ymmh[d->rm], 0, 16); }
+        return 1; }
+    case S_PCMPSTR:
+        if (d->L) return 0;
+        return exec_pcmpstr(s, d, ea, d->opc, imm, 1);
+    case S_LDMXCSR: case S_STMXCSR: {
+        if (d->L || !d->is_mem) return 0;
+        if (d->ext == 2) { uint32_t v; memcpy(&v, (const void *)(uintptr_t)ea, 4); s->mxcsr = v; return 1; }
+        if (d->ext == 3) { memcpy((void *)(uintptr_t)ea, &s->mxcsr, 4); return 1; }
+        return 0; }
+    case S_AESIMC: case S_AESKEYGEN: {
+        if (d->L) return 0;
+        aes_init();
+        get_rm(s, d, ea, 16, b);
+        if (o->id == S_AESIMC) { memcpy(out, b, 16); aes_mix(out, 1); }
+        else {
+            uint32_t x1, x3; memcpy(&x1, b + 4, 4); memcpy(&x3, b + 12, 4);
+            uint32_t sw1 = 0, sw3 = 0;
+            for (int i = 0; i < 4; ++i) { sw1 |= (uint32_t)aes_sbox[(x1 >> (8 * i)) & 0xFF] << (8 * i); sw3 |= (uint32_t)aes_sbox[(x3 >> (8 * i)) & 0xFF] << (8 * i); }
+            uint32_t w[4] = {sw1, ((sw1 >> 8) | (sw1 << 24)) ^ imm, sw3, ((sw3 >> 8) | (sw3 << 24)) ^ imm};
+            memcpy(out, w, 16);
+        }
+        set_vec(s, d->reg, 16, out);
+        return 1; }
+    case S_AESENC: case S_AESENCLAST: case S_AESDEC: case S_AESDECLAST: {
+        if (d->L) return 0;
+        aes_init();
+        get_vec(s, d->vvvv, 16, a); get_rm(s, d, ea, 16, b);
+        const int inv = o->id == S_AESDEC || o->id == S_AESDECLAST, last = o->id == S_AESENCLAST || o->id == S_AESDECLAST;
+        aes_shift_rows(a, inv); aes_sub(a, inv);
+        if (!last) aes_mix(a, inv);
+        for (int i = 0; i < 16; ++i) out[i] = a[i] ^ b[i];
+        set_vec(s, d->reg, 16, out);
+        return 1; }
+    case S_PCLMUL: {
+        if (d->L) return 0;
+        get_vec(s, d->vvvv, 16, a); get_rm(s, d, ea, 16, b);
+        uint64_t x, y, lo = 0, hi = 0;
+        memcpy(&x, a + ((imm & 1) ? 8 : 0), 8); memcpy(&y, b + ((imm & 0x10) ? 8 : 0), 8);
+        for (int i = 0; i < 64; ++i) if ((y >> i) & 1) { lo ^= x << i; if (i) hi ^= x >> (64 - i); }
+        memcpy(out, &lo, 8); memcpy(out + 8, &hi, 8);
+        set_vec(s, d->reg, 16, out);
+        return 1; }
+    case S_ANDN: case S_BEXTR: case S_BLSX: {
+        const int bits = d->W ? 64 : 32;
+        const uint64_t mask = d->W ? ~0ull : 0xFFFFFFFFull;
+        uint64_t src = 0;
+        if (d->is_mem) memcpy(&src, (const void *)(uintptr_t)ea, (size_t)bits / 8); else src = s->gpr[d->rm] & mask;
+        const uint64_t vv = s->gpr[d->vvvv] & mask;
+        uint64_t res;
+        if (o->id == S_ANDN) { res = ~vv & src & mask; s->gpr[d->reg] = res; set_flags_bmi(s, 0, !res, (res >> (bits - 1)) & 1); }
+        else if (o->id == S_BEXTR) {
+            unsigned start = vv & 0xFF, len = (vv >> 8) & 0xFF;
+            res = start >= (unsigned)bits ? 0 : src >> start;
+            if (len < (unsigned)bits) res &= ((uint64_t)1 << len) - 1;
+            res &= mask; s->gpr[d->reg] = res; set_flags_bmi(s, 0, !res, 0);
+        } else {
+            int cf;
+            if (d->ext == 1) { res = src & (src - 1); cf = src == 0; }
+            else if (d->ext == 2) { res = src ^ (src - 1); cf = src == 0; }
+            else if (d->ext == 3) { res = src & (0 - src); cf = src != 0; }
+            else return 0;
+            res &= mask; s->gpr[d->vvvv] = res; set_flags_bmi(s, cf, !res, (res >> (bits - 1)) & 1);
+        }
+        return 1; }
+    case S_PCMPGTQ:
+        if (d->L) return 0;
+        get_vec(s, d->vvvv, 16, a); get_rm(s, d, ea, 16, b);
+        for (int i = 0; i < 2; ++i) {
+            int64_t x, y; memcpy(&x, a + 8 * i, 8); memcpy(&y, b + 8 * i, 8);
+            uint64_t r = x > y ? ~0ull : 0; memcpy(out + 8 * i, &r, 8);
+        }
+        set_vec(s, d->reg, 16, out);
+        return 1;
+    }
+    return 0;
+}
+
+
+/* The few 256-bit forms that mix widths or reduce across lanes. */
+static int exec_l1_special(AvxState *s, const Dec *d, const Op *o, uint64_t ea, int *handled) {
+    *handled = 1;
+    const int opc = d->opc;
+    if (d->map == 1 && opc == 0x50) {                    /* vmovmskps/pd ymm */
+        if (d->is_mem) return 0;
+        uint8_t a[32];
+        get_vec(s, d->rm, 32, a);
+        const int w = d->pp == 1 ? 8 : 4;
+        uint64_t m = 0;
+        for (int i = 0, b = 0; i < 32; i += w, ++b) m |= (uint64_t)((a[i + w - 1] >> 7) & 1) << b;
+        s->gpr[d->reg] = m;
+        return 1;
+    }
+    if (d->map == 2 && opc == 0x17) {                    /* vptest ymm */
+        uint8_t a[32], b[32];
+        get_vec(s, d->reg, 32, a);
+        get_rm(s, d, ea, 32, b);
+        int zf = 1, cf = 1;
+        for (int i = 0; i < 32; ++i) { if (a[i] & b[i]) zf = 0; if ((uint8_t)~a[i] & b[i]) cf = 0; }
+        s->rflags = (s->rflags & ~0x8D5ull) | (zf ? 0x40ull : 0) | (cf ? 1ull : 0);
+        return 1;
+    }
+    if (d->map == 1 && (opc == 0x5A || opc == 0xE6)) {
+        const int widen = (opc == 0x5A && d->pp == 0) || (opc == 0xE6 && d->pp == 2);
+        const int narrow = (opc == 0x5A && d->pp == 1) || (opc == 0xE6 && (d->pp == 1 || d->pp == 3));
+        if (!widen && !narrow) { *handled = 0; return 0; }
+        uint8_t src[32] = {0}, out[32] = {0};
+        get_rm(s, d, ea, widen ? 16 : 32, src);
+        for (int lane = 0; lane < 2; ++lane) {
+            Thunk t; memset(&t, 0, sizeof t);
+            t.mxcsr = s->mxcsr;
+            if (widen) memcpy(t.x[1], src + 8 * lane, 8); else memcpy(t.x[1], src + 16 * lane, 16);
+            uint8_t code[16];
+            int n = build_legacy(code, d, o, 3, 0, 1, 0, 0);
+            const void *thunk = get_thunk(code, n);
+            if (!thunk) return 0;
+            call_thunk(thunk, &t);
+            s->mxcsr = t.mxcsr;
+            if (widen) memcpy(out + 16 * lane, t.x[0], 16); else memcpy(out + 8 * lane, t.x[0], 8);
+        }
+        set_vec(s, d->reg, widen ? 32 : 16, out);
+        return 1;
+    }
+    *handled = 0;
+    return 0;
+}
+
+/* vcmpps/pd/ss/sd with predicates 8..31 (legacy cmpps only has 0..7): built from the legacy ones. */
+static int exec_cmp_ext(AvxState *s, const Dec *d, const Op *o, uint64_t ea) {
+    enum { N, OR, AND, FALSE_, TRUE_ };
+    static const uint8_t t[24][3] = {
+        {0,3,OR},{3,1,OR},{3,2,OR},{0,0,FALSE_},{7,4,AND},{5,7,AND},{6,7,AND},{0,0,TRUE_},
+        {0,0,N},{1,0,N},{2,0,N},{3,0,N},{4,0,N},{5,0,N},{6,0,N},{7,0,N},
+        {0,3,OR},{3,1,OR},{3,2,OR},{0,0,FALSE_},{7,4,AND},{5,7,AND},{6,7,AND},{0,0,TRUE_}};
+    const uint8_t *e = t[d->imm - 8];
+    Dec dd = *d;
+    AvxState t1 = *s, t2 = *s;
+    dd.imm = e[0];
+    if (!exec_legacy(&t1, &dd, o, ea)) return 0;
+    const int lanes = ((o->fl & F_YMM) && d->L) ? 2 : 1;
+    const int scalar = d->pp >= 2, w = d->pp == 3 ? 8 : 4;
+    if (e[2] == OR || e[2] == AND) {
+        dd.imm = e[1];
+        if (!exec_legacy(&t2, &dd, o, ea)) return 0;
+        for (int l = 0; l < lanes; ++l) {
+            uint8_t *x = l ? t1.ymmh[d->reg] : t1.xmm[d->reg], *y = l ? t2.ymmh[d->reg] : t2.xmm[d->reg];
+            for (int i = 0; i < 16; ++i) x[i] = e[2] == OR ? (uint8_t)(x[i] | y[i]) : (uint8_t)(x[i] & y[i]);
+        }
+    } else if (e[2] == FALSE_ || e[2] == TRUE_) {
+        for (int l = 0; l < lanes; ++l) {
+            uint8_t *x = l ? t1.ymmh[d->reg] : t1.xmm[d->reg];
+            memset(x, e[2] == TRUE_ ? 0xFF : 0, scalar ? (size_t)w : 16);
+        }
+    }
+    memcpy(s->xmm[d->reg], t1.xmm[d->reg], 16);
+    memcpy(s->ymmh[d->reg], t1.ymmh[d->reg], 16);
+    s->mxcsr = t1.mxcsr | t2.mxcsr;
+    return 1;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* Entry points                                                                                 */
+/* ------------------------------------------------------------------------------------------ */
+static int emulate_vex(AvxState *s, const uint8_t *p, char *why, size_t why_size) {
+    Dec d;
+    memset(&d, 0, sizeof d);
+    int i;
+    int rexr, rexx = 0, rexb = 0;
+    if (p[0] == 0xC5) {
+        rexr = !(p[1] & 0x80);
+        d.vvvv = (~p[1] >> 3) & 15; d.L = (p[1] >> 2) & 1; d.pp = p[1] & 3; d.map = 1;
+        i = 2;
+    } else {
+        rexr = !(p[1] & 0x80); rexx = !(p[1] & 0x40); rexb = !(p[1] & 0x20);
+        d.map = p[1] & 31; d.W = p[2] >> 7;
+        d.vvvv = (~p[2] >> 3) & 15; d.L = (p[2] >> 2) & 1; d.pp = p[2] & 3;
+        i = 3;
+    }
+    d.opc = p[i++];
+    Op o;
+    if (!find_op(&d, &o)) return fail(why, why_size, p, "AVX: opcode not in table");
+    if (o.fl & F_ZERO) {
+        for (int r = 0; r < 16; ++r) { memset(s->ymmh[r], 0, 16); if (d.L) memset(s->xmm[r], 0, 16); }
+        return i;
+    }
+    decode_modrm(p, &i, &d, rexr, rexx, rexb);
+    if (o.fl & F_IMM) { d.has_imm = 1; d.imm = p[i++]; }
+    d.len = i;
+    uint64_t ea = d.is_mem ? effective_address(s, &d, p) : 0;
+    int ok;
+    if (o.fl & F_SOFT) ok = exec_soft(s, &d, &o, ea);
+    else if (o.fl & F_SHIFTI) ok = exec_shifti(s, &d, &o);
+    else if (o.fl & F_BLENDV) ok = exec_blendv(s, &d, ea);
+    else {
+        if (d.L && !(o.fl & F_YMM)) {
+            int handled;
+            ok = exec_l1_special(s, &d, &o, ea, &handled);
+            if (handled) return ok ? d.len : fail(why, why_size, p, "AVX: unsupported 256-bit form");
+        }
+        if (d.L && !allows_l1(&o)) return fail(why, why_size, p, "AVX: 256-bit form not supported");
+        if (o.map == 1 && o.opc == 0xC2 && d.imm >= 8) ok = exec_cmp_ext(s, &d, &o, ea);
+        else ok = exec_legacy(s, &d, &o, ea);
+    }
+    return ok ? d.len : fail(why, why_size, p, "AVX: unsupported form");
+}
+
+/* Legacy (non-VEX) instructions the host lacks: POPCNT, CRC32, PCMPGTQ. */
+static int emulate_legacy(AvxState *s, const uint8_t *p, char *why, size_t why_size) {
+    int i = 0, opsize16 = 0, rep = 0, repne = 0, rexw = 0, rexr = 0, rexx = 0, rexb = 0;
+    for (;; ++i) {
+        if (p[i] == 0x66) opsize16 = 1;
+        else if (p[i] == 0xF3) rep = 1;
+        else if (p[i] == 0xF2) repne = 1;
+        else break;
+    }
+    if ((p[i] & 0xF0) == 0x40) { rexw = (p[i] >> 3) & 1; rexr = (p[i] >> 2) & 1; rexx = (p[i] >> 1) & 1; rexb = p[i] & 1; ++i; }
+    if (p[i++] != 0x0F) return fail(why, why_size, p, "legacy: not 0F");
+    Dec d; memset(&d, 0, sizeof d);
+    int op = p[i++];
+    if (rep && op == 0xB8) {                                            /* POPCNT */
+        decode_modrm(p, &i, &d, rexr, rexx, rexb);
+        d.len = i;
+        uint64_t v;
+        const int bytes = rexw ? 8 : opsize16 ? 2 : 4;
+        if (d.is_mem) { v = 0; memcpy(&v, (const void *)(uintptr_t)effective_address(s, &d, p), (size_t)bytes); }
+        else { v = s->gpr[d.rm]; if (bytes < 8) v &= (1ull << (bytes * 8)) - 1; }
+        uint64_t r = (uint64_t)__builtin_popcountll(v);
+        if (bytes == 2) s->gpr[d.reg] = (s->gpr[d.reg] & ~0xFFFFull) | r;
+        else s->gpr[d.reg] = r;
+        s->rflags &= ~0x8D5ull;
+        if (!v) s->rflags |= 0x40;
+        return d.len;
+    }
+    if (opsize16 && op == 0x38 && p[i] == 0x37) {                       /* PCMPGTQ xmm, xmm/m128 */
+        ++i;
+        decode_modrm(p, &i, &d, rexr, rexx, rexb);
+        d.len = i;
+        uint8_t b[16];
+        if (d.is_mem) memcpy(b, (const void *)(uintptr_t)effective_address(s, &d, p), 16); else memcpy(b, s->xmm[d.rm], 16);
+        for (int k = 0; k < 2; ++k) {
+            int64_t x, y; memcpy(&x, s->xmm[d.reg] + 8 * k, 8); memcpy(&y, b + 8 * k, 8);
+            uint64_t r = x > y ? ~0ull : 0; memcpy(s->xmm[d.reg] + 8 * k, &r, 8);
+        }
+        return d.len;
+    }
+    if (opsize16 && op == 0x3A && p[i] >= 0x60 && p[i] <= 0x63) {     /* PCMPESTRI/M, PCMPISTRI/M */
+        int opc = p[i++];
+        decode_modrm(p, &i, &d, rexr, rexx, rexb);
+        uint8_t imm = p[i++];
+        d.len = i; d.W = rexw;
+        uint64_t ea = d.is_mem ? effective_address(s, &d, p) : 0;
+        exec_pcmpstr(s, &d, ea, opc, imm, 0);
+        return d.len;
+    }
+    if (!repne && op == 0x38 && (p[i] == 0xF0 || p[i] == 0xF1)) {       /* MOVBE (memory only) */
+        const int load = p[i] == 0xF0;
+        ++i;
+        decode_modrm(p, &i, &d, rexr, rexx, rexb);
+        d.len = i;
+        if (!d.is_mem) return fail(why, why_size, p, "legacy: movbe needs memory");
+        const int bytes = rexw ? 8 : opsize16 ? 2 : 4;
+        uint8_t *m = (uint8_t *)(uintptr_t)effective_address(s, &d, p), tmp[8] = {0};
+        if (load) {
+            uint64_t v = 0;
+            for (int k = 0; k < bytes; ++k) v |= (uint64_t)m[bytes - 1 - k] << (8 * k);
+            if (bytes == 2) s->gpr[d.reg] = (s->gpr[d.reg] & ~0xFFFFull) | v; else s->gpr[d.reg] = v;
+        } else {
+            for (int k = 0; k < bytes; ++k) tmp[k] = (uint8_t)(s->gpr[d.reg] >> (8 * (bytes - 1 - k)));
+            memcpy(m, tmp, (size_t)bytes);
+        }
+        return d.len;
+    }
+    if (repne && op == 0x38 && (p[i] == 0xF0 || p[i] == 0xF1)) {        /* CRC32 (Castagnoli) */
+        const int byte_form = p[i] == 0xF0;
+        ++i;
+        decode_modrm(p, &i, &d, rexr, rexx, rexb);
+        d.len = i;
+        const int bytes = byte_form ? 1 : rexw ? 8 : opsize16 ? 2 : 4;
+        uint64_t v = 0;
+        if (d.is_mem) memcpy(&v, (const void *)(uintptr_t)effective_address(s, &d, p), (size_t)bytes);
+        else { v = s->gpr[d.rm]; if (bytes < 8) v &= (1ull << (bytes * 8)) - 1; }
+        uint32_t crc = (uint32_t)s->gpr[d.reg];
+        for (int k = 0; k < bytes; ++k) {
+            crc ^= (uint32_t)((v >> (8 * k)) & 0xFF);
+            for (int b = 0; b < 8; ++b) crc = (crc >> 1) ^ (0x82F63B78u & (0u - (crc & 1)));
+        }
+        s->gpr[d.reg] = crc;
+        return d.len;
+    }
+    return fail(why, why_size, p, "legacy: unsupported");
+}
+
+int avx_emulate(AvxState *s, const uint8_t *insn, char *why, size_t why_size) {
+    if (insn[0] == 0xC4 || insn[0] == 0xC5) return emulate_vex(s, insn, why, why_size);
+    return emulate_legacy(s, insn, why, why_size);
+}
+
+int avx_emulate_run(AvxState *s, const uint8_t *insn, int max_insns, int *count, char *why, size_t why_size) {
+    int total = 0, n = 0;
+    while (n < max_insns) {
+        const uint8_t *p = insn + total;
+        if (n && p[0] != 0xC4 && p[0] != 0xC5) break;        /* only straight runs of VEX code */
+        int len = avx_emulate(s, p, n ? NULL : why, n ? 0 : why_size);
+        if (!len) break;
+        total += len;
+        ++n;
+    }
+    *count = n;
+    return total;
+}
diff --git a/src/avx_emulate.h b/src/avx_emulate.h
new file mode 100644
index 0000000..ec2cdc4
--- /dev/null
+++ b/src/avx_emulate.h
@@ -0,0 +1,38 @@
+/* Emulation of the guest's AVX (VEX), POPCNT and SSE4.2 instructions on hosts that lack them
+ * (Core 2 / Penryn, e.g. Q8400, which stops at SSE4.1). The guest code is compiled for the PS4's
+ * Jaguar CPU: AVX 128/256 bit, F16C, no AVX2.
+ *
+ * Design: a VEX instruction that has a legacy SSE twin (nearly all of them) is rebuilt as that
+ * legacy instruction and executed natively on fixed registers (xmm0..xmm3, rax, [rbx] = an
+ * aligned temp), so the host CPU itself produces the result. The 256-bit upper halves live in a
+ * per-thread shadow (AvxState.ymmh). Instructions with no legacy twin (vinsertf128, vpermilps,
+ * vbroadcast*, vmaskmov*, vtestps, vcvtph2ps, vpcmpgtq...) are done in portable C.
+ *
+ * Runs inside the exception handler, one instruction per call. Not fast: every call is a full
+ * exception dispatch. It exists to get the game running; hot sites are for a later rewrite. */
+#ifndef BB_AVX_EMULATE_H
+#define BB_AVX_EMULATE_H
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    uint64_t gpr[16];          /* x86 numbering; gpr[4] = rsp */
+    uint8_t xmm[16][16];       /* low 128 bits of xmm/ymm */
+    uint8_t ymmh[16][16];      /* bits 255:128 (shadow: the host has no ymm) */
+    uint64_t rflags;
+    uint32_t mxcsr;
+    int64_t ip_bias;           /* real address of an instruction minus the address its bytes are read from (0 unless they are a copy, avx_stub.c) */
+} AvxState;
+
+/* Executes the instruction at `insn` on `s`. Returns its length (> 0) on success, 0 when it is
+ * not supported (`why` gets one line with the opcode bytes). rip-relative operands are resolved
+ * against `insn` itself: guest addresses are host addresses in this port. */
+int avx_emulate(AvxState *s, const uint8_t *insn, char *why, size_t why_size);
+
+/* Emulates the instruction at `insn` and keeps going through the VEX instructions that directly
+ * follow it (up to max_insns): one fault then covers a whole run of AVX code. Stops, without
+ * error, at the first instruction that is not VEX or not supported. Returns the bytes consumed
+ * (0 when the first instruction fails, `why` is set then) and the instruction count in *count. */
+int avx_emulate_run(AvxState *s, const uint8_t *insn, int max_insns, int *count, char *why, size_t why_size);
+
+#endif
diff --git a/src/avx_stub.c b/src/avx_stub.c
new file mode 100644
index 0000000..6fe6eb2
--- /dev/null
+++ b/src/avx_stub.c
@@ -0,0 +1,187 @@
+/* See avx_stub.h. */
+#include "avx_stub.h"
+#include "isa_rewrite.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+_Static_assert(sizeof(AvxSite) == 64, "AvxSite is a 64 byte record");
+_Static_assert(sizeof(AvxRegs) == 400, "the trampoline assumes a 400 byte frame");
+
+static AvxShadowFn shadow_fn;
+static AvxFatalFn fatal_fn;
+static AvxTable *g_table;
+
+void avx_stub_set_hooks(AvxShadowFn shadow, AvxFatalFn fatal) { shadow_fn = shadow; fatal_fn = fatal; }
+
+static void die(const char *why) {
+    if (fatal_fn) fatal_fn(why);
+    fprintf(stderr, "AVX stub: %s\n", why);
+    fflush(NULL);
+    abort();
+}
+
+/* Runs on the trampoline's frame (SysV registers on every host: the trampoline is hand-written asm). */
+#if defined(__x86_64__)
+__attribute__((sysv_abi))
+#endif
+void bb_avx_dispatch(AvxRegs *r, const AvxSite *site) {
+    static uint8_t zero_shadow[256];
+    uint8_t *shadow = shadow_fn ? (uint8_t *)shadow_fn() : NULL;
+    if (!shadow) shadow = zero_shadow;
+    AvxState st;
+    memset(&st, 0, sizeof st);
+    memcpy(st.gpr, r->gpr, sizeof st.gpr);
+    memcpy(st.xmm, r->xmm, sizeof st.xmm);
+    memcpy(st.ymmh, shadow, sizeof st.ymmh);
+    st.rflags = r->rflags;
+    st.mxcsr = r->mxcsr;
+    uint8_t buf[AVX_EMU_MAX + 16];
+    memset(buf, 0, sizeof buf);
+    memcpy(buf, site->emu, site->emu_len);
+    st.ip_bias = (int64_t)((uintptr_t)(g_table->image + site->offset) - (uintptr_t)buf);
+    unsigned off = 0;
+    for (unsigned i = 0; i < site->n_insn; ++i) {
+        char why[200];
+        int len = avx_emulate(&st, buf + off, why, sizeof why);
+        if (len <= 0) die(why);
+        off += (unsigned)len;
+    }
+    if (off != site->emu_len) die("emulated length differs from the table");
+    memcpy(r->gpr, st.gpr, sizeof st.gpr);
+    memcpy(r->xmm, st.xmm, sizeof st.xmm);
+    memcpy(shadow, st.ymmh, sizeof st.ymmh);
