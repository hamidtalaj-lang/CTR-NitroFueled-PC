+        int64_t fwd = (int64_t)((uintptr_t)st - (uintptr_t)(at + 5));
+        if (back != (int32_t)back || fwd != (int32_t)fwd) { ++t->skipped; memset(st, 0xCC, AVX_STUB_BYTES); continue; }
