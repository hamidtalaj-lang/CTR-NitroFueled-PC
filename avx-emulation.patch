+/* VEX.L=1 on an op without a per-lane 256-bit form: fine for scalar ops (L is ignored), an error otherwise. */
+static int allows_l1(const Op *o) {
+    if (o->fl & F_YMM) return 1;
+    if (o->map == 1 && (o->opc == 0xE6 || (o->opc == 0x5A && (o->ppm & (P0 | P66))))) return 0;
+    return o->ms != 16 || (o->fl & F_MG);
+}
+
+static int op_msize(const Op *o, const Dec *d) {
+    switch (o->ms) {
+    case MS_PPSCALAR: return d->pp == 2 ? 4 : 8;
+    case MS_W: return d->W ? 8 : 4;
+    case MS_COMIS: return d->pp == 1 ? 8 : 4;
+    case MS_DDUP: return d->L ? 16 : 8;
+    default: return o->ms;
+    }
+}
