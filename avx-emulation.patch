diff -ruN -x out a/scripts/avx_samples.py CTR-NitroFueled-PC-0.4/scripts/avx_samples.py
--- a/scripts/avx_samples.py	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/avx_samples.py	2026-10-20 01:33:45.964133183 +0000
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Lists every distinct AVX (VEX) and POPCNT/CRC32/PCMPGTQ instruction encoding in eboot.bin, one hex
+string per line, for tests/test_avx_emulate.c (which runs them on a CPU that has AVX and compares
+the emulator with the real thing). Needs binutils' objdump.   usage: avx_samples.py eboot.bin out.txt"""
+import subprocess, sys
+sys.path.insert(0, __file__.rsplit('/', 1)[0] if '/' in __file__ else '.')
+from prepare import parse_self
+
+elf = parse_self(open(sys.argv[1], 'rb').read())[0]
+program_headers = elf[0x40:0x40 + 56 * int.from_bytes(elf[0x38:0x3A], 'little')]
+text = None
+for i in range(0, len(program_headers), 56):
+    ptype, flags = int.from_bytes(program_headers[i:i+4], 'little'), int.from_bytes(program_headers[i+4:i+8], 'little')
+    if ptype == 1 and flags & 1:
+        offset, size = int.from_bytes(program_headers[i+8:i+16], 'little'), int.from_bytes(program_headers[i+32:i+40], 'little')
+        text = elf[offset:offset + size]
+        break
+import os
+text = text[:int(os.environ.get('AVX_SAMPLES_LIMIT', len(text)))]
+open('/tmp/avx_text.bin', 'wb').write(text)
+dis = subprocess.Popen(['objdump', '-D', '-b', 'binary', '-m', 'i386:x86-64', '-M', 'intel', '/tmp/avx_text.bin'],
+                       stdout=subprocess.PIPE, text=True).stdout
+seen, cur = set(), None
+
+def flush():
+    if cur:
+        data, mnemonic = cur
+        if data and data[0] in ('c4', 'c5') or mnemonic in ('popcnt', 'crc32', 'pcmpgtq'):
+            seen.add(''.join(data))
+
+for line in dis:
+    parts = line.rstrip('\n').split('\t')
+    if len(parts) >= 2 and parts[0].strip().endswith(':'):
+        if len(parts) >= 3 and parts[2].strip():
+            flush()
+            cur = (parts[1].split(), parts[2].split()[0])
+        elif cur:
+            cur[0].extend(parts[1].split())
+flush()
+open(sys.argv[2], 'w').write('\n'.join(sorted(seen)) + '\n')
+print(len(seen), 'distinct encodings')
diff -ruN -x out a/src/avx_emulate.c CTR-NitroFueled-PC-0.4/src/avx_emulate.c
--- a/src/avx_emulate.c	1970-01-01 00:00:00.000000000 +0000
+++ b/src/avx_emulate.c	2026-10-20 08:03:20.469965266 +0000
@@ -0,0 +1,1014 @@
+/* See avx_emulate.h. Build with -mno-red-zone (the thunk call pushes below rsp). */
+#include "avx_emulate.h"
+#include <stdio.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#endif
+
+/* ------------------------------------------------------------------------------------------ */
+/* Native thunks: one legacy SSE instruction + ret, cached by its bytes.                        */
+/* ------------------------------------------------------------------------------------------ */
+typedef struct {
+    uint8_t x[4][16];            /* 0: xmm0..xmm3 */
+    uint64_t rax, rcx, rdx, rbx; /* 64..88 */
+    uint64_t flags;              /* 96 */
+    uint32_t mxcsr, pad;         /* 104 */
+} Thunk;
+
+static void call_thunk(const void *code, Thunk *t) {
+    uint32_t host;
+    __asm__ volatile(
+        "stmxcsr %[host]\n\t"
+        "ldmxcsr 104(%%rsi)\n\t"
+        "movups   0(%%rsi), %%xmm0\n\t"
+        "movups  16(%%rsi), %%xmm1\n\t"
+        "movups  32(%%rsi), %%xmm2\n\t"
+        "movups  48(%%rsi), %%xmm3\n\t"
+        "movq    72(%%rsi), %%rcx\n\t"
+        "movq    80(%%rsi), %%rdx\n\t"
+        "movq    88(%%rsi), %%rbx\n\t"
+        "movq    64(%%rsi), %%rax\n\t"
+        "call *%%rdi\n\t"
+        "movups %%xmm0,  0(%%rsi)\n\t"
+        "movups %%xmm1, 16(%%rsi)\n\t"
+        "movups %%xmm2, 32(%%rsi)\n\t"
+        "movups %%xmm3, 48(%%rsi)\n\t"
+        "movq   %%rax, 64(%%rsi)\n\t"
+        "movq   %%rcx, 72(%%rsi)\n\t"
+        "movq   %%rdx, 80(%%rsi)\n\t"
+        "movq   %%rbx, 88(%%rsi)\n\t"
+        "pushfq\n\t"
+        "popq   96(%%rsi)\n\t"
+        "stmxcsr 104(%%rsi)\n\t"
+        "ldmxcsr %[host]\n\t"
+        : [host] "=m"(host)
+        : "S"(t), "D"(code)
+        : "rax", "rcx", "rdx", "rbx", "memory", "cc", "xmm0", "xmm1", "xmm2", "xmm3");
+}
+
+enum { CACHE_SLOTS = 8192, POOL_BYTES = 1 << 18 };
+typedef struct { uint8_t key[16]; uint8_t n; volatile int ready; const void *code; } CacheEntry;
+static CacheEntry cache[CACHE_SLOTS];
+static uint8_t *pool;
+static size_t pool_used;
+static volatile int cache_lock;
+
+static uint8_t *alloc_exec(size_t n) {
+#ifdef _WIN32
+    return VirtualAlloc(NULL, n, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+#else
+    void *p = mmap(NULL, n, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    return p == MAP_FAILED ? NULL : p;
+#endif
+}
+
+static const void *get_thunk(const uint8_t *bytes, int n) {
+    uint8_t key[16] = {0};
+    memcpy(key, bytes, (size_t)n);
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < 16; ++i) h = (h ^ key[i]) * 16777619u;
+    for (int pass = 0; pass < 2; ++pass) {
+        if (pass) while (__atomic_exchange_n(&cache_lock, 1, __ATOMIC_ACQUIRE)) {}
+        for (uint32_t i = 0; i < CACHE_SLOTS; ++i) {
+            CacheEntry *e = &cache[(h + i) % CACHE_SLOTS];
+            if (__atomic_load_n(&e->ready, __ATOMIC_ACQUIRE)) {
+                if (e->n == n && !memcmp(e->key, key, 16)) { if (pass) __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE); return e->code; }
+                continue;
+            }
+            if (!pass) break;                    /* miss: retry under the lock */
+            if (!pool) pool = alloc_exec(POOL_BYTES);
+            if (!pool || pool_used + 16 > POOL_BYTES) { __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE); return NULL; }
+            uint8_t *slot = pool + pool_used;
+            pool_used += 16;
+            memcpy(slot, bytes, (size_t)n);
+            memcpy(e->key, key, 16);
+            e->n = (uint8_t)n;
+            e->code = slot;
+            __atomic_store_n(&e->ready, 1, __ATOMIC_RELEASE);
+            __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE);
+            return slot;
+        }
+    }
+    __atomic_store_n(&cache_lock, 0, __ATOMIC_RELEASE);
+    return NULL;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* Decoder                                                                                      */
+/* ------------------------------------------------------------------------------------------ */
+typedef struct {
+    int map, pp, L, W, vvvv, opc;
+    int reg, rm;                 /* extended register numbers (rm: register form only) */
+    int ext;                     /* modrm.reg low 3 bits (opcode extension) */
+    int is_mem, has_base, has_index, ripr, base, index, scale;
+    int64_t disp;
+    int has_imm; uint8_t imm;
+    int len;
+} Dec;
+
+static int fail(char *why, size_t n, const uint8_t *p, const char *msg) {
+    if (why && n) snprintf(why, n, "%s: %02x %02x %02x %02x %02x %02x %02x %02x", msg, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+    return 0;
+}
+
+/* Decodes modrm/sib/disp at p[*i]; rexr/rexx/rexb are the 0/1 extension bits. */
+static void decode_modrm(const uint8_t *p, int *i, Dec *d, int rexr, int rexx, int rexb) {
+    uint8_t m = p[(*i)++];
+    int mod = m >> 6, rm = m & 7;
+    d->ext = (m >> 3) & 7;
+    d->reg = d->ext | (rexr << 3);
+    if (mod == 3) { d->is_mem = 0; d->rm = rm | (rexb << 3); return; }
+    d->is_mem = 1;
+    if (rm == 4) {
+        uint8_t sib = p[(*i)++];
+        d->scale = sib >> 6;
+        int idx = ((sib >> 3) & 7) | (rexx << 3);
+        d->has_index = idx != 4;
+        d->index = idx;
+        d->base = (sib & 7) | (rexb << 3);
+        if ((sib & 7) == 5 && mod == 0) { d->has_base = 0; int32_t v; memcpy(&v, p + *i, 4); *i += 4; d->disp = v; }
+        else d->has_base = 1;
+    } else if (rm == 5 && mod == 0) {
+        int32_t v; memcpy(&v, p + *i, 4); *i += 4;
+        d->ripr = 1; d->disp = v;
+    } else { d->has_base = 1; d->base = rm | (rexb << 3); }
+    if (mod == 1) d->disp = (int8_t)p[(*i)++];
+    else if (mod == 2) { int32_t v; memcpy(&v, p + *i, 4); *i += 4; d->disp = v; }
+}
+
+static uint64_t effective_address(const AvxState *s, const Dec *d, const uint8_t *insn) {
+    if (d->ripr) return (uint64_t)(uintptr_t)(insn + d->len) + (uint64_t)d->disp;
+    uint64_t ea = (uint64_t)d->disp;
+    if (d->has_base) ea += s->gpr[d->base];
+    if (d->has_index) ea += s->gpr[d->index] << d->scale;
+    return ea;
+}
+
+/* ------------------------------------------------------------------------------------------ */
+/* Operation table                                                                              */
+/* ------------------------------------------------------------------------------------------ */
+enum {
+    F_NDS = 1,        /* vvvv is the first source (and the destination's initial value) */
+    F_NDSREG = 2,     /* ... only when rm is a register (vmovss/vmovsd) */
+    F_STORE = 4,      /* rm is the destination, reg the source */
+    F_NODST = 8,      /* sets flags only */
+    F_RG = 16,        /* reg operand is a general register */
+    F_MG = 32,        /* rm operand is a general register (or memory) */
+    F_IMM = 64,
+    F_YMM = 128,      /* 256-bit form = the same operation on both 128-bit lanes */
+    F_W64 = 256,      /* VEX.W selects a 64-bit general register: REX.W on the twin */
+    F_SOFT = 512,     /* done in C, `id` says which */
+    F_SPLIT4 = 1024,  /* imm8 holds 4 bits per lane (blendps) */
+    F_SPLIT2 = 2048,  /* imm8 holds 2 bits per lane (blendpd, shufpd) */
+    F_SHIFTI = 4096,  /* shift by immediate group (opcodes 71-73) */
+    F_BLENDV = 8192,  /* 4-operand blends: mask register in imm8[7:4] */
+    F_ZERO = 16384    /* vzeroupper / vzeroall */
+};
+enum { MS_PPSCALAR = 0xFA, MS_W = 0xFB, MS_COMIS = 0xFC, MS_DDUP = 0xFD };
+enum { S_INSERTF128 = 1, S_EXTRACTF128, S_PERM2F128, S_BCASTSS, S_BCASTSD, S_BCASTF128, S_PERMILPS_IMM,
+       S_PERMILPD_IMM, S_PERMILPS_VAR, S_PERMILPD_VAR, S_TESTPS, S_TESTPD, S_MASKLD_PS, S_MASKLD_PD,
+       S_MASKST_PS, S_MASKST_PD, S_CVTPH2PS, S_CVTPS2PH, S_PCMPGTQ, S_AESENC, S_AESENCLAST, S_AESDEC,
+       S_AESDECLAST, S_AESIMC, S_AESKEYGEN, S_PCLMUL, S_ANDN, S_BEXTR, S_BLSX, S_LDMXCSR, S_STMXCSR, S_PCMPSTR };
+#define P0 1
+#define P66 2
+#define PF3 4
+#define PF2 8
+typedef struct { uint8_t map, opc, ppm; uint16_t fl; uint8_t ms, id; } Op;
+
+static const Op ops[] = {
+    /* map 1 (0F) */
+    {1, 0x10, P0 | P66, F_YMM, 16, 0},       {1, 0x10, PF3 | PF2, F_NDSREG, MS_PPSCALAR, 0},
+    {1, 0x11, P0 | P66, F_STORE | F_YMM, 16, 0}, {1, 0x11, PF3 | PF2, F_STORE | F_NDSREG, MS_PPSCALAR, 0},
+    {1, 0x12, P0 | P66, F_NDS, 8, 0},        {1, 0x12, PF3, F_YMM, 16, 0},      {1, 0x12, PF2, F_YMM, MS_DDUP, 0},
+    {1, 0x13, P0 | P66, F_STORE, 8, 0},
+    {1, 0x14, P0 | P66, F_NDS | F_YMM, 16, 0},   {1, 0x15, P0 | P66, F_NDS | F_YMM, 16, 0},
+    {1, 0x16, P0 | P66, F_NDS, 8, 0},        {1, 0x16, PF3, F_YMM, 16, 0},
+    {1, 0x17, P0 | P66, F_STORE, 8, 0},
+    {1, 0x28, P0 | P66, F_YMM, 16, 0},       {1, 0x29, P0 | P66, F_STORE | F_YMM, 16, 0},
+    {1, 0x2A, PF3 | PF2, F_NDS | F_MG | F_W64, MS_W, 0},
+    {1, 0x2B, P0 | P66, F_STORE | F_YMM, 16, 0},
+    {1, 0x2C, PF3 | PF2, F_RG | F_W64, MS_PPSCALAR, 0}, {1, 0x2D, PF3 | PF2, F_RG | F_W64, MS_PPSCALAR, 0},
+    {1, 0x2E, P0 | P66, F_NODST, MS_COMIS, 0},   {1, 0x2F, P0 | P66, F_NODST, MS_COMIS, 0},
+    {1, 0x50, P0 | P66, F_RG, 16, 0},
+    {1, 0x51, P0 | P66, F_YMM, 16, 0},       {1, 0x51, PF3 | PF2, F_NDS, MS_PPSCALAR, 0},
+    {1, 0x52, P0, F_YMM, 16, 0},             {1, 0x52, PF3, F_NDS, 4, 0},
+    {1, 0x53, P0, F_YMM, 16, 0},             {1, 0x53, PF3, F_NDS, 4, 0},
+    {1, 0x54, P0 | P66, F_NDS | F_YMM, 16, 0}, {1, 0x55, P0 | P66, F_NDS | F_YMM, 16, 0},
+    {1, 0x56, P0 | P66, F_NDS | F_YMM, 16, 0}, {1, 0x57, P0 | P66, F_NDS | F_YMM, 16, 0},
+    {1, 0x58, P0 | P66, F_NDS | F_YMM, 16, 0}, {1, 0x58, PF3 | PF2, F_NDS, MS_PPSCALAR, 0},
+    {1, 0x59, P0 | P66, F_NDS | F_YMM, 16, 0}, {1, 0x59, PF3 | PF2, F_NDS, MS_PPSCALAR, 0},
+    {1, 0x5A, P0, 0, 8, 0},                  {1, 0x5A, P66, 0, 16, 0},
+    {1, 0x5A, PF3, F_NDS, 4, 0},             {1, 0x5A, PF2, F_NDS, 8, 0},
+    {1, 0x5B, P0 | P66 | PF3, F_YMM, 16, 0},
+    {1, 0x5C, P0 | P66, F_NDS | F_YMM, 16, 0}, {1, 0x5C, PF3 | PF2, F_NDS, MS_PPSCALAR, 0},
