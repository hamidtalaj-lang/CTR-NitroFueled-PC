+    FILE *f = fopen(argv[1], "r");
+    if (!f) { perror("samples"); return 2; }
+    struct sigaction sa; memset(&sa, 0, sizeof sa); sa.sa_handler = on_signal; sa.sa_flags = SA_NODEFER;
+    sigaction(SIGSEGV, &sa, NULL); sigaction(SIGILL, &sa, NULL); sigaction(SIGBUS, &sa, NULL); sigaction(SIGFPE, &sa, NULL);
+
+    enum { BUF = 0x100000, MID = 0x80000, WIN_PRE = 64, WIN = 256 };
+    uint8_t *buf = aligned_alloc(4096, BUF);
+    fill(buf, BUF);
+    uint8_t *exec = mmap(NULL, 8192, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+
+    typedef struct { uint8_t code[16]; int n; Dec d; int need_mem; } Item;
+    Item *items = malloc(sizeof(Item) * 200000);
+    long nitems = 0;
+    long tested = 0, passed = 0, failed = 0, unsupported = 0, skipped = 0, native_fault = 0, samples = 0, mxdiff = 0;
+    char line[256];
+    int shown = 0;
+    while (fgets(line, sizeof line, f)) {
+        uint8_t code[24] = {0};
+        int n = 0;
+        for (char *q = line; *q && *q != '\n' && n < 15; q += 2) { unsigned v; if (sscanf(q, "%2x", &v) != 1) break; code[n++] = (uint8_t)v; }
+        if (!n) continue;
+        ++samples;
+        /* decode just enough to place memory operands */
+        Dec d; Op o; memset(&d, 0, sizeof d);
+        char why[160] = "";
+        int is_vex = code[0] == 0xC4 || code[0] == 0xC5;
+        int need_mem = 0;
+        if (is_vex) {
+            int rr, xx = 0, bb = 0, i;
+            if (code[0] == 0xC5) { rr = !(code[1] & 0x80); d.vvvv = (~code[1] >> 3) & 15; d.L = (code[1] >> 2) & 1; d.pp = code[1] & 3; d.map = 1; i = 2; }
+            else { rr = !(code[1] & 0x80); xx = !(code[1] & 0x40); bb = !(code[1] & 0x20); d.map = code[1] & 31; d.W = code[2] >> 7; d.vvvv = (~code[2] >> 3) & 15; d.L = (code[2] >> 2) & 1; d.pp = code[2] & 3; i = 3; }
+            d.opc = code[i++];
+            if (!find_op(&d, &o)) { snprintf(why, sizeof why, "AVX: opcode not in table: map%d op%02x pp%d L%d", d.map, d.opc, d.pp, d.L); note(why); ++unsupported; continue; }
+            if (o.fl & F_ZERO) { need_mem = 0; }
+            else { decode_modrm(code, &i, &d, rr, xx, bb); need_mem = d.is_mem; if (o.fl & F_IMM) ++i; d.len = i; }
+        } else {                                   /* legacy: [66/F2/F3] [REX] 0F [38] op modrm */
+            int i = 0, rr = 0, xx = 0, bb = 0;
+            while (code[i] == 0x66 || code[i] == 0xF2 || code[i] == 0xF3) ++i;
+            if ((code[i] & 0xF0) == 0x40) { rr = (code[i] >> 2) & 1; xx = (code[i] >> 1) & 1; bb = code[i] & 1; ++i; }
+            if (code[i++] != 0x0F) { ++skipped; continue; }
+            int map3 = code[i] == 0x3A;
+            if (code[i] == 0x38 || code[i] == 0x3A) ++i;
+            ++i;
+            decode_modrm(code, &i, &d, rr, xx, bb);
+            if (map3) ++i;
+            need_mem = d.is_mem; d.len = i;
+            is_vex = 0;
+        }
+        if (need_mem) {
+            if (d.ripr == 0 && ((!d.has_base && !d.has_index) || (d.has_base && d.base == 4) || (d.has_base && d.has_index && d.base == d.index))) { ++skipped; continue; }
+            if (llabs(d.disp) > 0x70000) { ++skipped; continue; }
+        }
+        int strop = is_vex ? (o.id == S_PCMPSTR) : 0;
+        if (!is_vex) for (int k = 0; k + 2 < n; ++k) if (code[k] == 0x0F && code[k + 1] == 0x3A && code[k + 2] >= 0x60 && code[k + 2] <= 0x63) strop = 1;
+        uint8_t *at = exec;
+        int ripmap = 0;
+        if (d.ripr) {
+            uint64_t target = (uint64_t)(uintptr_t)(buf + MID);
+            uint64_t P = target - (uint64_t)d.len - (uint64_t)d.disp;
+            void *page = mmap((void *)(uintptr_t)(P & ~0xFFFull), 8192, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+            if (page == MAP_FAILED || (uint64_t)(uintptr_t)page != (P & ~0xFFFull)) { if (page != MAP_FAILED) munmap(page, 8192); ++skipped; continue; }
+            at = (uint8_t *)(uintptr_t)P; ripmap = 1;
+        }
+        memcpy(at, code, (size_t)n);
+        at[n] = 0xC3;
+        /* the native run executes the instruction then returns: place a ret right after it */
+        const long passed_before = passed;
+        for (int r = 0; r < rounds; ++r) {
+            NState ns; memset(&ns, 0, sizeof ns);
+            AvxState es; memset(&es, 0, sizeof es);
+            for (int g = 0; g < 16; ++g) ns.gpr[g] = rnd() & 1 ? rnd() : rnd() & 0xFFFF;
+            if (need_mem && !d.ripr) {
+                if (d.has_base) ns.gpr[d.base] = (uint64_t)(uintptr_t)(buf + MID);
+                if (d.has_index) ns.gpr[d.index] = 3;
+            }
+            for (int y = 0; y < 16; ++y) fill(ns.ymm[y], 32);
+            ns.flags = 0x202 | (rnd() & 0x8D5); ns.mxcsr = 0x1F80;
+            if (!is_vex || !need_mem) {}
+            uint64_t ea = 0;
+            if (need_mem) { AvxState tmp; memset(&tmp, 0, sizeof tmp); memcpy(tmp.gpr, ns.gpr, sizeof tmp.gpr); ea = effective_address(&tmp, &d, at); }
+            uint8_t *win = (uint8_t *)(uintptr_t)ea - WIN_PRE;
+            if (!need_mem) win = buf + MID;
+            fill(win, WIN);
+            if (strop) {
+                for (int g = 0; g < 16; ++g) if (g == 0 || g == 2) { int64_t v = (int64_t)(rnd() % 24) - 4; if (!(need_mem && !d.ripr && ((d.has_base && d.base == g) || (d.has_index && d.index == g)))) ns.gpr[g] = (uint64_t)v; }
+                const uint8_t alpha = (rnd() & 1) ? 3 : 7;
+                for (int y = 0; y < 16; ++y) for (int b = 0; b < 32; ++b) ns.ymm[y][b] = (uint8_t)((rnd() % 5 == 0) ? 0 : (rnd() & alpha));
+                for (int b = 0; b < WIN; ++b) win[b] = (uint8_t)((rnd() % 5 == 0) ? 0 : (rnd() & alpha));
+            }
+            uint8_t w0[WIN], wn[WIN], we[WIN];
+            memcpy(w0, win, WIN);
+            /* emulator state mirrors the native one */
+            memcpy(es.gpr, ns.gpr, sizeof es.gpr);
+            for (int y = 0; y < 16; ++y) { memcpy(es.xmm[y], ns.ymm[y], 16); memcpy(es.ymmh[y], ns.ymm[y] + 16, 16); }
+            es.rflags = ns.flags; es.mxcsr = ns.mxcsr;
+            AvxState e0 = es;
+            int len = avx_emulate(&es, at, why, sizeof why);
+            if (!len) { note(why); ++unsupported; break; }
+            memcpy(we, win, WIN);
+            memcpy(win, w0, WIN);
+            NState ns0 = ns;
+            if (sigsetjmp(trap, 1)) { ++native_fault; if (native_fault <= 12) { printf("NATIVE-FAULT "); for (int k = 0; k < n; ++k) printf("%02x", code[k]); printf(" ea=%llx\n", (unsigned long long)ea); } break; }
+            native_run(&ns, at);
+            memcpy(wn, win, WIN);
+            ++tested;
+            int bad = 0; char detail[200] = "";
+            for (int g = 0; g < 16 && !bad; ++g) if (g != 4 && ns.gpr[g] != es.gpr[g]) { bad = 1; snprintf(detail, sizeof detail, "gpr%d native=%016llx emu=%016llx", g, (unsigned long long)ns.gpr[g], (unsigned long long)es.gpr[g]); }
+            for (int y = 0; y < 16 && !bad; ++y) {
+                if (memcmp(ns.ymm[y], es.xmm[y], 16)) { bad = 1; snprintf(detail, sizeof detail, "ymm%d low differs", y); }
+                else if (memcmp(ns.ymm[y] + 16, es.ymmh[y], 16)) { bad = 1; snprintf(detail, sizeof detail, "ymm%d high differs", y); }
+            }
+            if (!bad && memcmp(wn, we, WIN)) { bad = 1; snprintf(detail, sizeof detail, "memory differs"); }
+            int fmask = 0;
+            if (is_vex && ((o.fl & F_NODST) || o.id == S_TESTPS || o.id == S_TESTPD)) fmask = 0x8D5;
+            if (is_vex && (o.id == S_ANDN || o.id == S_BLSX)) fmask = 0x8C1;
+            if (is_vex && o.id == S_BEXTR) fmask = 0x841;
+            if (strop) fmask = 0x8D5;
+            if (!is_vex) for (int k = 0; k + 1 < n; ++k) if (code[k] == 0x0F && code[k + 1] == 0xB8) fmask = 0x8D5;
+            if (!bad && fmask && ((ns.flags ^ es.rflags) & fmask)) { bad = 1; snprintf(detail, sizeof detail, "flags native=%llx emu=%llx", (unsigned long long)(ns.flags & fmask), (unsigned long long)(es.rflags & fmask)); }
+            if (!bad && ((ns.mxcsr ^ es.mxcsr) & 0x3F)) ++mxdiff;
+            (void)e0; (void)ns0;
+            if (bad) {
+                ++failed;
+                if (shown < 40) { ++shown; printf("MISMATCH "); for (int k = 0; k < n; ++k) printf("%02x", code[k]); printf(" : %s\n", detail); }
+                break;
+            }
+            ++passed;
+        }
+        if (passed - passed_before == rounds && is_vex && !d.ripr && nitems < 200000) {
+            Item *it = &items[nitems++];
+            memcpy(it->code, code, (size_t)n); it->n = n; it->d = d; it->need_mem = need_mem;
+        }
+        if (ripmap) munmap((void *)(uintptr_t)((uint64_t)(uintptr_t)at & ~0xFFFull), 8192);
+    }
+
+    /* Sequence test: random straight runs of the instructions that passed alone, run natively and
+     * through avx_emulate_run, which must consume the whole run in one call. */
+    long seq_tested = 0, seq_passed = 0, seq_failed = 0, seq_skipped = 0, seq_short = 0;
+    const int seq_count = argc > 3 ? atoi(argv[3]) : 20000;
+    for (int q = 0; q < seq_count && nitems > 1; ++q) {
+        int k = 2 + (int)(rnd() % 7);
+        Item *pick[8];
+        int role[16] = {0}, bad_roles = 0;
+        for (int i = 0; i < k && !bad_roles; ++i) {
+            pick[i] = &items[rnd() % (uint64_t)nitems];
+            const Dec *dd = &pick[i]->d;
+            if (!pick[i]->need_mem) continue;
+            if (dd->has_base) { if (role[dd->base] == 2) bad_roles = 1; role[dd->base] = 1; }
+            if (dd->has_index) { if (role[dd->index] == 1) bad_roles = 1; role[dd->index] = 2; }
+            if (dd->has_base && dd->has_index && dd->base == dd->index) bad_roles = 1;
+        }
+        if (bad_roles) { ++seq_skipped; continue; }
+        uint8_t seq[256]; int total = 0;
+        for (int i = 0; i < k; ++i) { memcpy(seq + total, pick[i]->code, (size_t)pick[i]->n); total += pick[i]->n; }
+        seq[total] = 0xC3;
+        memcpy(exec, seq, (size_t)total + 1);
+        NState ns; memset(&ns, 0, sizeof ns);
+        for (int g = 0; g < 16; ++g) ns.gpr[g] = role[g] == 1 ? (uint64_t)(uintptr_t)(buf + MID) : role[g] == 2 ? 3 : (rnd() & 1 ? rnd() : rnd() & 0xFFFF);
+        for (int y = 0; y < 16; ++y) fill(ns.ymm[y], 32);
+        ns.flags = 0x202 | (rnd() & 0x8D5); ns.mxcsr = 0x1F80;
+        AvxState es; memset(&es, 0, sizeof es);
+        memcpy(es.gpr, ns.gpr, sizeof es.gpr);
+        for (int y = 0; y < 16; ++y) { memcpy(es.xmm[y], ns.ymm[y], 16); memcpy(es.ymmh[y], ns.ymm[y] + 16, 16); }
+        es.rflags = ns.flags; es.mxcsr = ns.mxcsr;
+        /* memory span the run can touch */
+        uint64_t lo = ~0ull, hi = 0;
+        for (int i = 0; i < k; ++i) if (pick[i]->need_mem) {
+            uint64_t ea = effective_address(&es, &pick[i]->d, exec);
+            if (ea < lo) lo = ea;
+            if (ea + 32 > hi) hi = ea + 32;
+        }
+        if (lo == ~0ull) { lo = (uint64_t)(uintptr_t)(buf + MID); hi = lo + 32; }
+        lo -= 64; hi += 64;
+        if (hi - lo > 8192) { ++seq_skipped; continue; }
+        uint8_t m0[8192], mn[8192], me[8192];
+        const size_t span = (size_t)(hi - lo);
+        fill((uint8_t *)(uintptr_t)lo, span & ~7ull);
+        memcpy(m0, (void *)(uintptr_t)lo, span);
+        char why[160] = "";
+        int cnt = 0;
+        int used = avx_emulate_run(&es, exec, 256, &cnt, why, sizeof why);
+        memcpy(me, (void *)(uintptr_t)lo, span);
+        memcpy((void *)(uintptr_t)lo, m0, span);
+        if (used != total || cnt != k) { ++seq_short; if (seq_short <= 5) { printf("SEQ-SHORT used %d of %d, %d of %d insns: ", used, total, cnt, k); for (int i = 0; i < total; ++i) printf("%02x", seq[i]); printf(" %s\n", why); } continue; }
+        if (sigsetjmp(trap, 1)) { ++seq_skipped; continue; }
+        native_run(&ns, exec);
+        memcpy(mn, (void *)(uintptr_t)lo, span);
+        ++seq_tested;
+        int bad = 0;
+        for (int g = 0; g < 16 && !bad; ++g) if (g != 4 && ns.gpr[g] != es.gpr[g]) bad = 1;
+        for (int y = 0; y < 16 && !bad; ++y) if (memcmp(ns.ymm[y], es.xmm[y], 16) || memcmp(ns.ymm[y] + 16, es.ymmh[y], 16)) bad = 1;
+        if (!bad && memcmp(mn, me, span)) bad = 1;
+        if (bad) { ++seq_failed; if (seq_failed <= 10) { printf("SEQ-MISMATCH "); for (int i = 0; i < total; ++i) printf("%02x", seq[i]); printf("\n"); } }
+        else ++seq_passed;
+    }
+    printf("sequences: tested %ld  passed %ld  failed %ld  short %ld  skipped %ld\n", seq_tested, seq_passed, seq_failed, seq_short, seq_skipped);
+    failed += seq_failed;
+    printf("samples %ld  tested-rounds %ld  passed %ld  failed %ld  unsupported %ld  skipped %ld  native-fault %ld  mxcsr-flag-diffs %ld\n",
+           samples, tested, passed, failed, unsupported, skipped, native_fault, mxdiff);
+    for (int i = 0; i < nreasons; ++i) printf("  %5d x %s\n", reasons[i].n, reasons[i].text);
+    return failed ? 1 : 0;
+}
diff -ruN a/tests/test_avx_stub.c b/tests/test_avx_stub.c
--- a/tests/test_avx_stub.c	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_avx_stub.c	2026-10-31 10:53:35.337362232 +0000
@@ -0,0 +1,221 @@
+/* Test of the AVX stubs (src/avx_stub.c + isa_rewrite.c, kind ISA_AVX). Linux, a CPU with AVX.
+ *
+ * A leaf-style function full of AVX instructions that keeps live data in the red zone is run twice
+ * on the same input: as it is (the host executes the AVX natively) and rewritten (every site goes
+ * through an AVX stub and the emulator). Memory, the registers, the flags, xmm8/xmm15, mxcsr and the
+ * red zone must come out identical. Then four threads do it concurrently.
+ *
+ *   gcc -std=gnu11 -O1 -mno-red-zone -Isrc tests/test_avx_stub.c src/avx_emulate.c src/avx_stub.c \
+ *       src/isa_rewrite.c src/isa_emulate.c -pthread -o out/avx-stub-test && out/avx-stub-test */
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include "avx_emulate.h"
+#include "avx_stub.h"
+#include "isa_rewrite.h"
+
+/* (The function avoids push/pop and call inside the red zone: its own pushes would overwrite it.)
+ * in: 0x00 ymm0 source, 0x20 ymm1 source, 0x40 xmm5, 0x50 xmm8, 0x60 xmm15 (rdi); out: 0x200 bytes (rsi); r10 = 1 misaligns rsp */
+__asm__(
+    ".text\n.p2align 4\n.intel_syntax noprefix\n"
+    ".globl t_begin\nt_begin:\n"
+    "    push rbx\n    push rbp\n    push r12\n    push r13\n    push r14\n    push r15\n"
+    "    mov r10, rdx\n"
+    "    mov [rsp-8], rdi\n    mov [rsp-16], rsi\n"
+    "    mov rax, 0x1111111111111111\n    mov [rsp-24], rax\n"
+    "    mov rax, 0x2222222222222222\n    mov [rsp-32], rax\n"
+    "    mov rax, 0x3333333333333333\n    mov [rsp-40], rax\n"
+    "    mov rax, 0x4444444444444444\n    mov [rsp-48], rax\n"
+    "    mov rax, 0x5555555555555555\n    mov [rsp-56], rax\n"
+    "    mov rax, 0x6666666666666666\n    mov [rsp-64], rax\n"
+    "    mov rax, 0x7777777777777777\n    mov [rsp-72], rax\n"
+    "    mov rax, 0x8888888888888888\n    mov [rsp-80], rax\n"
+    "    mov rax, 0x9999999999999999\n    mov [rsp-88], rax\n"
+    "    mov rax, 0xaaaaaaaaaaaaaaaa\n    mov [rsp-96], rax\n"
+    "    mov rax, 0xbbbbbbbbbbbbbbbb\n    mov [rsp-104], rax\n"
+    "    mov rax, 0xcccccccccccccccc\n    mov [rsp-112], rax\n"
+    "    mov rax, 0xdddddddddddddddd\n    mov [rsp-120], rax\n"
+    "    mov rax, 0xeeeeeeeeeeeeeeee\n    mov [rsp-128], rax\n"
+    "    mov rbx, 0xb1b1b1b1b1b1b1b1\n    mov rcx, 0xc2c2c2c2c2c2c2c2\n    mov rdx, 0xd3d3d3d3d3d3d3d3\n"
+    "    mov rbp, 0xe4e4e4e4e4e4e4e4\n"
+    "    mov r8, 0x0808080808080808\n    mov r9, 0x0909090909090909\n    mov r11, 0x1111010101010101\n"
+    "    mov r12, 0x1212121212121212\n    mov r13, 0x1313131313131313\n    mov r14, 0x1414141414141414\n"
+    "    mov r15, 0x1515151515151515\n"
+    "    movdqu xmm5, [rdi+0x40]\n    movdqu xmm8, [rdi+0x50]\n    movdqu xmm15, [rdi+0x60]\n"
+    "    mov dword ptr [rsp-0x90], 0x7f80\n    ldmxcsr [rsp-0x90]\n"
+    "    test r10, r10\n    jz 1f\n    sub rsp, 8\n1:\n"
+    "    stc\n"
+    ".globl t_site_a\nt_site_a: .byte 0xc5,0xfc,0x10,0x07\n"          /* vmovups ymm0,[rdi]          4: relocate lea */
+    "    lea r9, [r9+1]\n"
+    ".globl t_site_b\nt_site_b: .byte 0xc5,0xfc,0x10,0x4f,0x20\n"     /* vmovups ymm1,[rdi+0x20]     5: jmp */
+    "    lahf\n    movzx eax, ah\n    mov [rsi+0x70], rax\n"
+    ".globl t_site_c\nt_site_c: .byte 0xc5,0xfc,0x58,0xd1\n"          /* vaddps ymm2,ymm0,ymm1       4: relocate nop */
+    "    nop\n"
+    ".globl t_site_d\nt_site_d: .byte 0xc5,0xfc,0x11,0x16\n"          /* vmovups [rsi],ymm2          4: relocate nop */
+    "    nop\n"
+    ".globl t_site_e\nt_site_e: .byte 0xc5,0xfc,0x11,0x46,0x20\n"     /* vmovups [rsi+0x20],ymm0     5 */
+    ".globl t_site_f\nt_site_f: .byte 0xc5,0xfc,0x10,0x1d\n    .long t_const - (t_site_f + 8)\n"   /* vmovups ymm3,[rip+const] 8 */
+    ".globl t_site_g\nt_site_g: .byte 0xc5,0xfc,0x11,0x5e,0x40\n"     /* vmovups [rsi+0x40],ymm3     5 */
+    ".globl t_site_h\nt_site_h: .byte 0xc5,0xfc,0x50,0xc2\n"          /* vmovmskps eax,ymm2          4: relocate mov */
+    "    mov [rsi+0x60], rax\n"
+    ".globl t_site_i\nt_site_i: .byte 0xc5,0xf8,0x2e,0xc1\n"          /* vucomiss xmm0,xmm1          4: relocate lahf */
+    "    lahf\n    movzx eax, ah\n    mov [rsi+0x68], rax\n"
+    "    test r10, r10\n    jz 2f\n    add rsp, 8\n2:\n"
+    "    mov [rsi+0x78], rbx\n    mov [rsi+0x80], rcx\n    mov [rsi+0x88], rdx\n    mov [rsi+0x90], rbp\n"
+    "    mov [rsi+0x98], r8\n    mov [rsi+0xa0], r9\n    mov [rsi+0xa8], r11\n    mov [rsi+0xb0], r12\n"
+    "    mov [rsi+0xb8], r13\n    mov [rsi+0xc0], r14\n    mov [rsi+0xc8], r15\n"
+    "    movdqu [rsi+0x100], xmm8\n    movdqu [rsi+0x110], xmm15\n    movdqu [rsi+0x120], xmm5\n"
+    "    stmxcsr [rsi+0x130]\n"
+    "    mov rax, [rsp-24]\n    mov [rsi+0x140], rax\n    mov rax, [rsp-32]\n    mov [rsi+0x148], rax\n"
+    "    mov rax, [rsp-40]\n    mov [rsi+0x150], rax\n    mov rax, [rsp-48]\n    mov [rsi+0x158], rax\n"
+    "    mov rax, [rsp-56]\n    mov [rsi+0x160], rax\n    mov rax, [rsp-64]\n    mov [rsi+0x168], rax\n"
+    "    mov rax, [rsp-72]\n    mov [rsi+0x170], rax\n    mov rax, [rsp-80]\n    mov [rsi+0x178], rax\n"
+    "    mov rax, [rsp-88]\n    mov [rsi+0x180], rax\n    mov rax, [rsp-96]\n    mov [rsi+0x188], rax\n"
+    "    mov rax, [rsp-104]\n    mov [rsi+0x190], rax\n    mov rax, [rsp-112]\n    mov [rsi+0x198], rax\n"
+    "    mov rax, [rsp-120]\n    mov [rsi+0x1a0], rax\n    mov rax, [rsp-128]\n    mov [rsi+0x1a8], rax\n"
+    "    mov rax, [rsp-8]\n    mov [rsi+0x1b0], rax\n    mov rax, [rsp-16]\n    mov [rsi+0x1b8], rax\n"
+    "    pop r15\n    pop r14\n    pop r13\n    pop r12\n    pop rbp\n    pop rbx\n    ret\n"
+    ".p2align 4\nt_const:\n    .float 1.5, 2.5, 3.5, 4.5, -5.5, 6.25, 7.75, 8.125\n"
+    ".globl t_end\nt_end:\n"
+    ".att_syntax prefix\n");
+
+extern const char t_begin[], t_end[], t_site_a[], t_site_b[], t_site_c[], t_site_d[], t_site_e[], t_site_f[],
+    t_site_g[], t_site_h[], t_site_i[];
+typedef void (*TestFn)(const uint8_t *in, uint8_t *out, uint64_t misalign);
+
+/* The dispatch of probe.c, with a thread-local ymm upper-half shadow. */
+static __thread uint8_t ymmh[16][16];
+static IsaTable *table;
+static void ABI dispatch(const IsaSite *site, AvxStubFrame *f) {
+    uint8_t bytes[16] = {0};
+    char why[200];
+    memcpy(bytes, site->original, site->length);
+    AvxState st;
+    memcpy(st.gpr, f->gpr, sizeof st.gpr);
+    memcpy(st.xmm, f->xmm, sizeof st.xmm);
+    memcpy(st.ymmh, ymmh, sizeof st.ymmh);
+    st.rflags = f->rflags;
+    st.mxcsr = f->mxcsr;
+    int len = avx_emulate_at(&st, bytes, (const uint8_t *)table->image + site->offset, why, sizeof why);
+    if (len != (int)site->length) { fprintf(stderr, "dispatch: %s\n", why); abort(); }
+    memcpy(f->gpr, st.gpr, sizeof st.gpr);
+    memcpy(f->xmm, st.xmm, sizeof st.xmm);
+    memcpy(ymmh, st.ymmh, sizeof ymmh);
+    f->rflags = st.rflags;
+    f->mxcsr = st.mxcsr;
+    __atomic_add_fetch(&table->hits[site - table->sites], 1, __ATOMIC_RELAXED);
+}
+
+static void fill(uint8_t *p, size_t n, unsigned seed) {
+    for (size_t i = 0; i < n; ++i) { seed = seed * 1103515245u + 12345u; p[i] = (uint8_t)(seed >> 16); }
+}
+
+static TestFn patched;
+/* out+0x1b8 holds the function's own copy of rsi (the out pointer): it must match its buffer, then it is ignored. */
+static int own_pointer(uint8_t *out) {
+    uint64_t v;
+    memcpy(&v, out + 0x1b8, 8);
+    int ok = v == (uint64_t)(uintptr_t)out;
+    memset(out + 0x1b8, 0, 8);
+    return ok;
+}
+static int compare(uint8_t *a, uint8_t *b, const char *what) {
+    int bad = 0;
+    if (!own_pointer(a) || !own_pointer(b)) { printf("  %s: red zone slot of the out pointer differs from the pointer\n", what); bad++; }
+    for (int i = 0; i < 0x1c0; ++i)
+        if (a[i] != b[i]) {
+            if (!bad) printf("  %s: first difference at out+0x%x: native %02x, rewritten %02x\n", what, i, a[i], b[i]);
+            bad++;
+        }
+    return bad;
+}
+
+typedef struct { unsigned seed; int rounds; int bad; } Job;
+static void *job(void *arg) {
+    Job *j = arg;
+    for (int r = 0; r < j->rounds; ++r) {
+        uint8_t in[0x80], out1[0x200] = {0}, out2[0x200] = {0};
+        fill(in, sizeof in, j->seed + (unsigned)r);
+        ((TestFn)t_begin)(in, out1, (uint64_t)(r & 1));
+        patched(in, out2, (uint64_t)(r & 1));
+        j->bad += compare(out1, out2, "thread");
+        if (j->bad) break;
+    }
+    return NULL;
+}
+
+static void put(IsaSite *s, const char *at, uint8_t len, uint8_t mode, const uint8_t *reloc, uint8_t rlen) {
+    memset(s, 0, sizeof *s);
+    s->offset = (uint64_t)(at - t_begin);
+    s->length = len; s->kind = ISA_AVX; s->mode = mode;
+    s->dst = s->src1 = s->src2 = s->base = s->index = ISA_NO_REG;
+    memcpy(s->original, at, len);
+    s->relocated_length = rlen;
+    if (rlen) memcpy(s->relocated, reloc, rlen);
+}
+
+int main(void) {
+    const size_t code_size = (size_t)(t_end - t_begin);
+    const uint8_t lea_r9[] = {0x4d, 0x8d, 0x49, 0x01}, nop[] = {0x90}, mov_rax[] = {0x48, 0x89, 0x46, 0x60}, lahf[] = {0x9f};
+    IsaSite sites[9];
+    put(&sites[0], t_site_a, 4, ISA_MODE_JMP_RELOCATE, lea_r9, 4);
+    put(&sites[1], t_site_b, 5, ISA_MODE_JMP, NULL, 0);
+    put(&sites[2], t_site_c, 4, ISA_MODE_JMP_RELOCATE, nop, 1);
+    put(&sites[3], t_site_d, 4, ISA_MODE_JMP_RELOCATE, nop, 1);
+    put(&sites[4], t_site_e, 5, ISA_MODE_JMP, NULL, 0);
+    put(&sites[5], t_site_f, 8, ISA_MODE_JMP, NULL, 0);
+    put(&sites[6], t_site_g, 5, ISA_MODE_JMP, NULL, 0);
+    put(&sites[7], t_site_h, 4, ISA_MODE_JMP_RELOCATE, mov_rax, 4);
+    put(&sites[8], t_site_i, 4, ISA_MODE_JMP_RELOCATE, lahf, 1);
+
+    unsigned char header[64] = {'B', 'B', 'I', 'S', 'A', '1', 0, 0};
+    uint64_t image_size = code_size;
+    uint32_t count = 9;
+    memcpy(header + 8, &image_size, 8);
+    memcpy(header + 48, &count, 4);
+    FILE *f = fopen("/tmp/avx-stub-test.bin", "wb");
+    if (!f || fwrite(header, 1, 64, f) != 64 || fwrite(sites, sizeof sites[0], 9, f) != 9) { perror("table"); return 2; }
+    fclose(f);
+    table = isa_table_load("/tmp/avx-stub-test.bin");
+    if (!table) return 2;
+    printf("table: %u records, %u avx, stub area %zu bytes\n", table->count, table->avx_count, isa_stub_area_size(table));
+
+    /* code and stubs in one mapping, so rel32 reaches */
+    size_t area = 0x10000 + ((isa_stub_area_size(table) + 0xfff) & ~(size_t)0xfff);
+    unsigned char *region = mmap(NULL, area, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (region == MAP_FAILED) { perror("mmap"); return 2; }
+    memcpy(region, t_begin, code_size);
+    avx_stub_set_dispatch(dispatch);
+    isa_rewrite_set_avx(avx_stub_common_entry());
+    IsaReport r = isa_rewrite_apply(table, region, region + 0x10000, ISA_SET_AVX);
+    printf("rewritten %u (jmp %u, relocated %u), skipped %u\n", r.rewritten, r.jmp, r.relocated, r.skipped);
+    if (r.rewritten != 9 || r.skipped) { puts("FAIL: not every site was rewritten"); return 1; }
+    for (int i = 0; i < 9; ++i)
+        if (region[sites[i].offset] != 0xe9) { printf("FAIL: site %d was not patched with a jmp\n", i); return 1; }
+    patched = (TestFn)(void *)region;
+
+    int bad = 0;
+    for (int round = 0; round < 2000 && !bad; ++round) {
+        uint8_t in[0x80], out1[0x200] = {0}, out2[0x200] = {0};
+        fill(in, sizeof in, 7u + (unsigned)round);
+        uint64_t misalign = (uint64_t)(round & 1);
+        ((TestFn)t_begin)(in, out1, misalign);
+        patched(in, out2, misalign);
+        bad += compare(out1, out2, "single");
+    }
+    printf("single thread: %s\n", bad ? "FAIL" : "ok (2000 rounds, red zone, registers, flags, xmm, mxcsr identical)");
+    if (bad) return 1;
+
+    pthread_t th[4];
+    Job jobs[4];
+    for (int i = 0; i < 4; ++i) { jobs[i] = (Job){100u * (unsigned)i + 1u, 20000, 0}; pthread_create(&th[i], NULL, job, &jobs[i]); }
+    for (int i = 0; i < 4; ++i) { pthread_join(th[i], NULL); bad += jobs[i].bad; }
+    printf("4 threads: %s\n", bad ? "FAIL" : "ok (4 x 20000 rounds)");
+    unsigned long long total = 0;
+    for (uint32_t i = 0; i < table->count; ++i) total += table->hits[i];
+    printf("emulated instructions through stubs: %llu\n", total);
+    return bad ? 1 : 0;
+}
