+/* Load-time rewrite of AVX / POPCNT / SSE4.2 sites into stubs (red-zone safe).
+ *
+ * Why: on Windows the exception dispatcher writes CONTEXT below rsp *before* any handler runs,
+ * so a fault inside a System V leaf function destroys its 128-byte red zone. The fault-handler
+ * emulation (probe.c) cannot fix that. Here the site is patched with a 5-byte jmp to a stub that
+ * first moves rsp down 0x100 bytes (lea: flags untouched), saves every register, and only then
+ * calls the same emulator (avx_emulate.c) on a saved copy of the original bytes. No exception
+ * is raised, so nothing is ever written into the red zone.
+ *
+ * Table: BBAVX1, written by scripts/avx_rewrite.py. Sites it cannot cover (no 5 bytes without
+ * crossing a branch target) stay on the fault-handler path. */
+#ifndef BB_AVX_STUB_H
+#define BB_AVX_STUB_H
+#include <stddef.h>
+#include <stdint.h>
+#include "avx_emulate.h"
+
+#define AVX_EMU_MAX 32     /* bytes of emulated instructions per site */
+#define AVX_RELOC_MAX 16   /* bytes of the plain instruction copied into the stub */
+
+typedef struct {           /* 64 bytes on disk */
+    uint64_t offset;       /* image offset of the first covered byte */
+    uint8_t emu_len;       /* bytes of the instructions to emulate */
+    uint8_t n_insn;        /* how many instructions that is */
+    uint8_t reloc_len;     /* 0, or the length of a plain instruction run natively after them */
+    uint8_t reserved[5];
+    uint8_t emu[AVX_EMU_MAX];      /* their original bytes */
+    uint8_t reloc[AVX_RELOC_MAX];  /* the relocated instruction's original bytes */
+} AvxSite;                 /* covered = emu_len + reloc_len >= 5 */
+
+typedef struct {
+    AvxSite *sites;
+    uint32_t count;
+    uint64_t image_size;
+    uint8_t sha256[32];
+    unsigned char *image, *stubs;   /* set by avx_stub_apply */
+    uint64_t skipped;
+} AvxTable;
+
+enum { AVX_STUB_BYTES = 64 };   /* lea, push, mov, call, lea, relocated insn, jmp, 8-byte target */
+
+/* Frame the trampoline builds; the dispatcher reads and writes it. */
+typedef struct {
+    uint64_t gpr[16];      /* x86 numbering; gpr[4] = the guest's rsp */
+    uint64_t rflags;
+    uint32_t mxcsr, pad;
+    uint8_t xmm[16][16];
+} AvxRegs;
+
+/* Pointer to the calling thread's 16x16 byte ymm-upper shadow (256 bytes). */
+typedef void *(*AvxShadowFn)(void);
+/* Called when an instruction cannot be emulated: `why` is one line. Must not return. */
+typedef void (*AvxFatalFn)(const char *why);
+void avx_stub_set_hooks(AvxShadowFn shadow, AvxFatalFn fatal);
+
+size_t avx_stub_area_size(uint32_t count);
+/* Patches the sites into `image` and writes the stubs into `stubs` (RW, area size; it must lie within +-2 GB of the image).
+ * A site whose bytes no longer match the table is skipped. Returns the number rewritten. */
+uint32_t avx_stub_apply(AvxTable *t, unsigned char *image, unsigned char *stubs);
+
+AvxTable *avx_table_load(const char *path);          /* NULL and one stderr line when invalid */
+int avx_table_matches(const AvxTable *t, const unsigned char *image, uint64_t size);  /* 0 = match */
+/* Index of the site whose stub holds rip, or -1 (for fault reports). */
+int avx_stub_site_of(const AvxTable *t, uintptr_t rip);
+/* Index of the site whose covered bytes contain image offset `offset`, or -1 (slow: only for fault reports). */
+int avx_stub_site_covering(const AvxTable *t, uint64_t offset);
+
