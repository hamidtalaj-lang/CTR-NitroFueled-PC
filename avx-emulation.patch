+        while (n < AVX_STUB_BYTES - 8) st[n++] = 0xCC;
+        put64(st + AVX_STUB_BYTES - 8, (uint64_t)(uintptr_t)&bb_avx_tramp);
+        at[0] = 0xE9; put32(at + 1, (uint32_t)(int32_t)fwd);
