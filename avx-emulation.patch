+ * ymm upper halves, which the host cannot hold, live in a per-thread shadow. BB_AVX_EMULATE=0
+ * turns it off (the old STOP). */
+static int avx_emulation;
+static unsigned long long avx_emulated;
+typedef struct { uintptr_t rip; uint8_t bytes[8]; int count; } AvxHist;
+typedef struct { unsigned long tid; uint8_t ymmh[16][16]; AvxHist hist[16]; unsigned hist_n; } AvxThread;
+static int avx_run_max = 128;   /* BB_AVX_RUN_MAX=1 turns the batching off (one instruction per fault) */
+static void avx_record(AvxThread *t, uintptr_t rip, int count) {
+    AvxHist *h = &t->hist[t->hist_n++ & 15];
+    h->rip = rip; h->count = count;
+    memcpy(h->bytes, (const void *)rip, 8);
+}
+static AvxThread avx_threads[512];
+#ifdef _WIN32
+#define AVX_TID() ((unsigned long)GetCurrentThreadId())
+#else
+#define AVX_TID() ((unsigned long)syscall(SYS_gettid))
+#endif
+static AvxThread *avx_thread(void) {
+    const unsigned long tid = AVX_TID();
+    for (unsigned i = 0; i < 512; ++i) {
+        AvxThread *t = &avx_threads[(unsigned)(tid * 2654435761u + i) & 511];
+        unsigned long cur = __atomic_load_n(&t->tid, __ATOMIC_ACQUIRE), zero = 0;
+        if (cur == tid) return t;
